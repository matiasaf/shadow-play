---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import {
  useTranslations,
  localizePath,
  getLangFromUrl,
  stripLangFromPath,
  type Lang,
} from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t('meta.home');

const home = localizePath('/', lang);
const directors = localizePath('/directors', lang);
const map = localizePath('/map', lang);
const upnext = localizePath('/up-next', lang);
const current = stripLangFromPath(Astro.url.pathname);
const section =
  current === '/' || current.startsWith('/films')
    ? 'films'
    : ['directors', 'map', 'up-next'].find((name) => current.startsWith(`/${name}`));
const currentFor = (name: string) => (section === name ? 'page' : undefined);
const about = `${home === '/' ? '' : home}/#about`.replace('//', '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,500;1,700;1,900&family=Source+Serif+4:ital,wght@0,400;0,600;1,400;1,600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='black'/><text x='4' y='12' fill='white' font-family='serif' font-size='11'>S</text></svg>"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <div class="grain-overlay" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a href={home} class="brand">{t('brand')}<span class="dot">.</span></a>
        <div class="header-end">
          <nav class="site-nav">
            <a href={home} aria-current={currentFor('films')}>{t('nav.films')}</a>
            <a href={directors} aria-current={currentFor('directors')}>{t('nav.directors')}</a>
            <a href={map} aria-current={currentFor('map')}>{t('nav.map')}</a>
            <a href={upnext} aria-current={currentFor('up-next')}>{t('nav.upnext')}</a>
          </nav>
          <LanguageSwitcher />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <span class="footer-brand">{t('brand')}</span>
          <p>{t('footer.tagline')} · {new Date().getFullYear()}</p>
        </div>
        <nav class="footer-nav" aria-label="Secondary sections">
          <a href={home}>{t('footer.archive')}</a>
          <a href={directors}>{t('footer.directors')}</a>
          <a href={map}>{t('footer.map')}</a>
          <a href={upnext}>{t('footer.upnext')}</a>
          <a href={about}>{t('footer.manifesto')}</a>
        </nav>
      </div>
    </footer>

    <style>
      .header-end {
        display: flex;
        align-items: center;
        gap: clamp(1.25rem, 4vw, 2.5rem);
        flex-wrap: wrap;
      }

      @media (max-width: 960px) {
        .site-header .wrap {
          flex-wrap: wrap;
          gap: 0.9rem 1.25rem;
          padding-block: 1rem;
        }

        .brand {
          margin-right: auto;
        }

        .header-end {
          display: contents;
        }

        .site-nav {
          order: 3;
          width: 100%;
          justify-content: space-between;
          gap: 0.75rem;
          border-top: 1px solid var(--border);
          padding-top: 0.75rem;
        }
      }

      @media (max-width: 640px) {
        .site-header .wrap {
          gap: 0.5rem 1rem;
          padding-block: 0.7rem 0.35rem;
        }

        .site-nav {
          display: flex;
          flex-wrap: nowrap;
          justify-content: space-between;
          overflow-x: auto;
          scrollbar-width: none;
          gap: 0.75rem;
          letter-spacing: 0.08em;
          padding-top: 0.35rem;
        }

        .site-nav::-webkit-scrollbar {
          display: none;
        }

        .site-nav a {
          flex: none;
          white-space: nowrap;
          padding-block: 0.35rem;
        }
      }
    </style>
  </body>
</html>
