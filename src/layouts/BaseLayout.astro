---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Un cuaderno de cine: estudio las películas que voy viendo.' } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🎞️</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">Cuaderno de cine<span class="dot">.</span></a>
        <nav class="site-nav">
          <a href="/">Películas</a>
          <a href="/mapa">El mapa</a>
          <a href="/#sobre">Sobre el cuaderno</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <span class="footer-brand">Cuaderno de cine</span>
          <p>Escrito a mano, una película a la vez · {new Date().getFullYear()}</p>
        </div>
        <nav class="footer-nav" aria-label="Secciones secundarias">
          <a href="/">Archivo</a>
          <a href="/mapa">Mapa</a>
          <a href="/#sobre">Manifiesto</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
