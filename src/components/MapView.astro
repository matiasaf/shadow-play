---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getMovies, slugOf } from '../lib/movies';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const movies = await getMovies(lang);

// Nodes are keyed by the language-neutral slug ("heat"), so connections
// declared with that slug resolve within the current language.
const nodes = movies.map((m) => ({
  id: slugOf(m),
  title: m.data.title,
  director: m.data.director,
  year: m.data.year,
  logline: m.data.logline,
  tags: m.data.tags,
}));
const ids = new Set(nodes.map((n) => n.id));

const keyFor = (a: string, b: string) => [a, b].sort().join('__');
const edges = new Map<
  string,
  { source: string; target: string; type: 'explicit' | 'tag'; note: string }
>();

for (const m of movies) {
  const from = slugOf(m);
  for (const c of m.data.connections) {
    if (!ids.has(c.slug)) continue;
    edges.set(keyFor(from, c.slug), {
      source: from,
      target: c.slug,
      type: 'explicit',
      note: c.note,
    });
  }
}

for (let i = 0; i < movies.length; i++) {
  for (let j = i + 1; j < movies.length; j++) {
    const a = movies[i]!;
    const b = movies[j]!;
    const shared = a.data.tags.filter((tag) => b.data.tags.includes(tag));
    if (shared.length === 0) continue;
    const key = keyFor(slugOf(a), slugOf(b));
    if (edges.has(key)) continue;
    edges.set(key, {
      source: slugOf(a),
      target: slugOf(b),
      type: 'tag',
      note: `${t('map.shareNote')}: ${shared.join(', ')}`,
    });
  }
}

const links = [...edges.values()];
const degree: Record<string, number> = Object.fromEntries(nodes.map((n) => [n.id, 0]));
for (const l of links) {
  degree[l.source]!++;
  degree[l.target]!++;
}

const graph = {
  nodes: nodes.map((n) => ({ ...n, degree: degree[n.id] ?? 0 })),
  links,
};

const config = {
  filmsBase: localizePath('/films/', lang),
  noRelations: t('map.noRelations'),
};
---

<BaseLayout title={`${t('map.title')} — ${t('brand')}`} description={t('meta.map')} lang={lang}>
  <section class="wrap intro map-intro">
    <p class="eyebrow">{t('map.eyebrow')}</p>
    <h1>{t('map.title')}</h1>
    <p>{t('map.intro')}</p>
  </section>

  <section class="wrap map-wrap">
    <div class="map-shell">
      <div class="map-stage">
        <svg id="graph" role="img" aria-label={t('map.svgLabel')}></svg>
        <div class="map-hints" aria-hidden="true">
          <span>{t('map.drag')}</span>
          <span>{t('map.zoom')}</span>
        </div>
      </div>

      <aside class="map-panel" id="panel">
        <div class="panel-head">
          <span>{t('map.studyFile')}</span>
          <button class="panel-close" id="panel-close" aria-label={t('map.close')}>×</button>
        </div>
        <div class="paper-card">
          <div class="paper-frame" id="panel-frame"><span id="panel-initial">S</span></div>
          <h2 id="panel-title">{t('brand')}</h2>
          <p class="panel-meta" id="panel-meta">{t('map.selectFilm')}</p>
          <div class="panel-tags" id="panel-tags"></div>
          <div class="panel-observation">
            <span>{t('map.observations')}</span>
            <p id="panel-desc">{t('map.placeholderDesc')}</p>
          </div>
          <a class="panel-link" id="panel-link" href={localizePath('/', lang)}>{t('map.seeStudy')}</a>
        </div>
        <div class="panel-relations">
          <h3 id="panel-conn-h">{t('map.related')}</h3>
          <ul class="panel-conns" id="panel-conns"></ul>
        </div>
      </aside>
    </div>

    {
      links.length === 0 && (
        <p class="map-empty">
          {t('map.empty')}
        </p>
      )
    }
  </section>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)} />
  <script type="application/json" id="map-config" set:html={JSON.stringify(config)} />

  <script>
    import * as d3 from 'd3';

    type Node = {
      id: string;
      title: string;
      director: string;
      year: number;
      logline: string;
      tags: string[];
      degree: number;
      x?: number;
      y?: number;
      fx?: number | null;
      fy?: number | null;
    };
    type Link = {
      source: string | Node;
      target: string | Node;
      type: 'explicit' | 'tag';
      note: string;
    };

    const dataEl = document.getElementById('graph-data');
    const configEl = document.getElementById('map-config');
    if (dataEl) {
      const graph = JSON.parse(dataEl.textContent || '{}') as { nodes: Node[]; links: Link[] };
      const config = JSON.parse(configEl?.textContent || '{}') as {
        filmsBase: string;
        noRelations: string;
      };
      const nodes = graph.nodes;
      const links = graph.links;

      const svgEl = document.getElementById('graph') as unknown as SVGSVGElement;
      const panel = document.getElementById('panel')!;

      const idOf = (n: string | Node) => (typeof n === 'string' ? n : n.id);
      const slideSize = (d: Node) => 74 + Math.min(d.degree, 4) * 8;

      const neighbors = new Map<string, Set<string>>(nodes.map((n) => [n.id, new Set<string>()]));
      for (const l of links) {
        neighbors.get(idOf(l.source))!.add(idOf(l.target));
        neighbors.get(idOf(l.target))!.add(idOf(l.source));
      }

      let width = svgEl.clientWidth || 800;
      let height = Math.max(560, Math.round(width * 0.62));

      const svg = d3.select(svgEl).attr('viewBox', `0 0 ${width} ${height}`);
      const container = svg.append('g');

      const zoom = d3
        .zoom<SVGSVGElement, unknown>()
        .scaleExtent([0.45, 3.5])
        .on('zoom', (e) => container.attr('transform', e.transform.toString()));
      svg.call(zoom);

      const link = container
        .append('g')
        .attr('class', 'links')
        .selectAll('line')
        .data(links)
        .join('line')
        .attr('class', (d) => `edge edge-${d.type}`);

      const node = container
        .append('g')
        .attr('class', 'nodes')
        .selectAll<SVGGElement, Node>('g')
        .data(nodes)
        .join('g')
        .attr('class', 'node')
        .style('cursor', 'pointer');

      node
        .append('rect')
        .attr('class', 'slide-shadow')
        .attr('x', (d) => -slideSize(d) / 2 + 5)
        .attr('y', (d) => -slideSize(d) / 2 + 9)
        .attr('width', slideSize)
        .attr('height', (d) => slideSize(d) * 1.18);

      node
        .append('rect')
        .attr('class', 'slide-frame')
        .attr('x', (d) => -slideSize(d) / 2)
        .attr('y', (d) => -slideSize(d) / 2)
        .attr('width', slideSize)
        .attr('height', (d) => slideSize(d) * 1.18);

      node
        .append('rect')
        .attr('class', 'slide-window')
        .attr('x', (d) => -slideSize(d) / 2 + 8)
        .attr('y', (d) => -slideSize(d) / 2 + 8)
        .attr('width', (d) => slideSize(d) - 16)
        .attr('height', (d) => slideSize(d) * 0.82);

      node
        .append('text')
        .attr('class', 'slide-initial')
        .attr('y', 8)
        .text((d) => d.title.charAt(0));

      node
        .append('text')
        .attr('class', 'slide-code')
        .attr('y', (d) => slideSize(d) / 2 + 16)
        .text((d, i) => `#${String(i + 1).padStart(2, '0')} ${d.director.split(' ').at(-1)}`);

      node
        .append('text')
        .attr('class', 'slide-title')
        .attr('y', (d) => slideSize(d) / 2 + 34)
        .text((d) => d.title);

      const sim = d3
        .forceSimulation<Node>(nodes)
        .force(
          'link',
          d3
            .forceLink<Node, Link>(links)
            .id((d) => d.id)
            .distance((l) => (l.type === 'explicit' ? 170 : 230))
            .strength((l) => (l.type === 'explicit' ? 0.5 : 0.2))
        )
        .force('charge', d3.forceManyBody().strength(-520))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force(
          'collide',
          d3.forceCollide<Node>().radius((d) => slideSize(d) * 0.86)
        )
        .on('tick', ticked);

      function ticked() {
        link
          .attr('x1', (d) => (d.source as Node).x!)
          .attr('y1', (d) => (d.source as Node).y!)
          .attr('x2', (d) => (d.target as Node).x!)
          .attr('y2', (d) => (d.target as Node).y!);
        node.attr('transform', (d) => `translate(${d.x},${d.y})`);
      }

      node.call(
        d3
          .drag<SVGGElement, Node>()
          .on('start', (e, d) => {
            if (!e.active) sim.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (e, d) => {
            d.fx = e.x;
            d.fy = e.y;
          })
          .on('end', (e, d) => {
            if (!e.active) sim.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          })
      );

      let selected: string | null = null;

      function select(id: string | null) {
        selected = id;
        if (!id) {
          node.classed('dim', false).classed('active', false);
          link.classed('dim', false).classed('hot', false);
          panel.classList.remove('is-filled');
          return;
        }
        const near = neighbors.get(id)!;
        node.classed('active', (n) => n.id === id);
        node.classed('dim', (n) => n.id !== id && !near.has(n.id));
        link.classed('hot', (l) => idOf(l.source) === id || idOf(l.target) === id);
        link.classed('dim', (l) => idOf(l.source) !== id && idOf(l.target) !== id);
        fillPanel(id);
      }

      function fillPanel(id: string) {
        const n = nodes.find((x) => x.id === id)!;
        (document.getElementById('panel-title') as HTMLElement).textContent = n.title;
        (document.getElementById('panel-meta') as HTMLElement).textContent = `${n.year} · ${n.director}`;
        (document.getElementById('panel-desc') as HTMLElement).textContent = `"${n.logline}"`;
        (document.getElementById('panel-initial') as HTMLElement).textContent = n.title.charAt(0);

        const tagsEl = document.getElementById('panel-tags') as HTMLElement;
        tagsEl.innerHTML = '';
        for (const tag of n.tags) {
          const span = document.createElement('span');
          span.className = 'tag';
          span.textContent = tag;
          tagsEl.appendChild(span);
        }

        const related = links.filter((l) => idOf(l.source) === id || idOf(l.target) === id);
        const list = document.getElementById('panel-conns') as HTMLElement;
        list.innerHTML = '';
        for (const l of related) {
          const otherId = idOf(l.source) === id ? idOf(l.target) : idOf(l.source);
          const other = nodes.find((x) => x.id === otherId)!;
          const li = document.createElement('li');
          li.innerHTML = `<a href="${config.filmsBase}${other.id}/"><span>${other.title.charAt(0)}</span><strong>${other.title}</strong></a><em class="${
            l.type === 'explicit' ? 'why' : 'why faint'
          }">${l.note}</em>`;
          list.appendChild(li);
        }
        if (related.length === 0) {
          const li = document.createElement('li');
          li.className = 'empty-relation';
          li.textContent = config.noRelations;
          list.appendChild(li);
        }

        (document.getElementById('panel-link') as HTMLAnchorElement).href = `${config.filmsBase}${id}/`;
        panel.classList.add('is-filled');
      }

      node.on('click', (e, d) => {
        e.stopPropagation();
        select(selected === d.id ? null : d.id);
      });
      svg.on('click', () => select(null));
      document.getElementById('panel-close')!.addEventListener('click', () => select(null));

      if (nodes[0]) select(nodes[0].id);

      window.addEventListener('resize', () => {
        width = svgEl.clientWidth || width;
        height = Math.max(560, Math.round(width * 0.62));
        svg.attr('viewBox', `0 0 ${width} ${height}`);
        sim.force('center', d3.forceCenter(width / 2, height / 2));
        sim.alpha(0.3).restart();
      });
    }
  </script>
</BaseLayout>

<style>
  .map-intro {
    padding-block: 4rem 2.5rem;
    text-align: center;
  }

  .map-intro .eyebrow {
    margin-inline: auto;
  }

  .map-intro h1 {
    max-width: none;
  }

  .map-intro p:not(.eyebrow) {
    margin-inline: auto;
  }

  .map-wrap {
    padding-bottom: 5rem;
  }

  .map-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    min-height: 680px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .map-stage {
    position: relative;
    min-height: 680px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgba(150, 178, 207, 0.06), transparent 70%),
      var(--bg);
  }

  .map-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.25;
    background-image:
      radial-gradient(rgba(227, 227, 222, 0.16) 1px, transparent 1px),
      linear-gradient(rgba(227, 227, 222, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(227, 227, 222, 0.045) 1px, transparent 1px);
    background-size: 18px 18px, 96px 96px, 96px 96px;
  }

  #graph {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }

  .map-hints {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .map-hints span {
    width: fit-content;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    background: rgba(30, 32, 29, 0.58);
    color: var(--text-soft);
    font-size: 0.58rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .map-empty {
    color: var(--text-faint);
    text-align: center;
    padding-block: 3rem;
  }

  .map-empty code {
    color: var(--accent);
    background: var(--surface);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .map-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 100%;
    border-left: 1px solid var(--border);
    padding: 1.5rem;
    background: var(--surface);
    overflow-y: auto;
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
    color: var(--text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .panel-close {
    border: 0;
    background: transparent;
    color: var(--text-faint);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .panel-close:hover {
    color: var(--accent);
  }

  .paper-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    clip-path: polygon(0 0, 100% 1%, 99% 99%, 1% 100%);
    padding: 1.6rem;
    background:
      radial-gradient(rgba(40, 46, 54, 0.08) 1px, transparent 1px) 0 0 / 16px 16px,
      #e7eaee;
    color: #20262e;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
    transform: rotate(0.8deg);
  }

  .paper-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(40, 46, 54, 0.16);
    background:
      radial-gradient(circle at 50% 40%, rgba(150, 178, 207, 0.22), transparent 55%),
      #14181d;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 4rem;
  }

  .paper-card h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.05;
  }

  .panel-meta {
    color: rgba(32, 38, 46, 0.72);
    font-size: 0.82rem;
    font-style: italic;
  }

  .panel-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .panel-tags .tag {
    border-color: rgba(32, 38, 46, 0.24);
    color: #20262e;
    font-weight: 700;
  }

  .panel-observation {
    border-top: 1px solid rgba(32, 38, 46, 0.1);
    padding-top: 1rem;
  }

  .panel-observation span {
    display: block;
    margin-bottom: 0.45rem;
    color: rgba(32, 38, 46, 0.54);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .panel-observation p {
    color: rgba(32, 38, 46, 0.78);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-style: italic;
    line-height: 1.55;
  }

  .panel-link {
    width: fit-content;
    border: 2px solid #1c2733;
    padding: 0.55rem 0.9rem;
    color: #1c2733;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .panel-link:hover {
    background: #1c2733;
    color: var(--accent);
    transform: rotate(-1deg);
  }

  .panel-relations h3 {
    margin-bottom: 0.85rem;
    padding-inline: 0.4rem;
    color: var(--text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .panel-conns {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    padding: 0;
  }

  .panel-conns li {
    border: 1px solid var(--border-soft);
    background: var(--surface-high);
    padding: 0.8rem;
  }

  .panel-conns a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
  }

  .panel-conns a span {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.5rem;
    border: 4px solid #e3e3de;
    background: #1f211d;
    color: var(--accent);
    font-family: var(--font-serif);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
  }

  .panel-conns strong {
    font-size: 0.92rem;
  }

  .panel-conns .why {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-soft);
    font-size: 0.78rem;
    font-style: normal;
    line-height: 1.45;
  }

  .panel-conns .why.faint {
    color: var(--text-faint);
    font-style: italic;
  }

  .empty-relation {
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 980px) {
    .map-shell {
      grid-template-columns: 1fr;
    }

    .map-panel {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 680px) {
    .map-stage,
    .map-shell {
      min-height: 520px;
    }

    .map-hints {
      display: none;
    }

    .map-panel {
      padding: 1rem;
    }
  }
</style>

<style is:global>
  #graph .edge {
    stroke-width: 1.5;
    transition: opacity 0.2s ease, stroke-width 0.2s ease;
  }

  #graph .edge-explicit {
    stroke: var(--accent-strong);
    stroke-dasharray: 4 2;
    stroke-opacity: 0.7;
    filter: drop-shadow(0 0 3px rgba(150, 178, 207, 0.28));
    animation: map-dash 30s linear infinite;
  }

  #graph .edge-tag {
    stroke: var(--border);
    stroke-dasharray: 2 5;
    stroke-opacity: 0.42;
  }

  #graph .edge.hot {
    stroke-opacity: 1;
    stroke-width: 2.4;
  }

  #graph .edge.dim {
    opacity: 0.08;
  }

  #graph .node {
    transition: opacity 0.2s ease;
  }

  #graph .node .slide-shadow {
    fill: rgba(0, 0, 0, 0.34);
    filter: blur(2px);
  }

  #graph .node .slide-frame {
    fill: #e3e3de;
    stroke: #c8c6c5;
    stroke-width: 1;
    transition: fill 0.25s ease, filter 0.25s ease, transform 0.25s ease;
  }

  #graph .node .slide-window {
    fill: #1c1f1a;
    stroke: rgba(32, 38, 46, 0.18);
    stroke-width: 1;
  }

  #graph .node .slide-initial {
    fill: var(--accent);
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  #graph .node .slide-code {
    fill: #20262e;
    font-family: var(--font-sans);
    font-size: 8px;
    font-style: italic;
    opacity: 0.66;
    text-anchor: middle;
  }

  #graph .node .slide-title {
    fill: var(--text-soft);
    font-family: var(--font-sans);
    font-size: 12px;
    font-style: italic;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-linejoin: round;
    stroke-width: 4px;
    text-anchor: middle;
  }

  #graph .node.active .slide-frame {
    fill: var(--accent);
    filter: drop-shadow(0 18px 22px rgba(150, 178, 207, 0.26));
  }

  #graph .node.active .slide-window {
    fill: #151710;
  }

  #graph .node.active .slide-title {
    fill: var(--accent);
    font-weight: 700;
  }

  #graph .node.dim {
    opacity: 0.23;
  }

  @keyframes map-dash {
    to {
      stroke-dashoffset: -100;
    }
  }
</style>
