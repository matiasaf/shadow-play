---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getMovies, slugOf } from '../lib/movies';
import { directorSlug, getDirectors, obsessionsOf } from '../lib/directors';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const movies = await getMovies(lang);
const directors = await getDirectors(lang);

const filmNodes = movies.map((movie) => ({
  id: `film:${slugOf(movie)}`,
  slug: slugOf(movie),
  kind: 'film' as const,
  title: movie.data.title,
  director: movie.data.director,
  directorSlug: directorSlug(movie.data.director),
  year: movie.data.year,
  logline: movie.data.logline,
  tags: movie.data.tags,
  frame: movie.data.frame?.src ?? null,
}));

const directorNodes = directors.map((director) => ({
  id: `director:${director.slug}`,
  slug: director.slug,
  kind: 'director' as const,
  title: director.name,
  worldview: director.entry?.data.worldview ?? t('director.essayPending'),
  obsessions: obsessionsOf(director),
  filmIds: director.films.map((film) => `film:${slugOf(film)}`),
}));

const filmIds = new Set(filmNodes.map((node) => node.slug));
const keyFor = (a: string, b: string) => [a, b].sort().join('__');
const relationLinks = new Map<
  string,
  { source: string; target: string; type: 'idea' | 'theme'; note: string }
>();

for (const movie of movies) {
  const from = slugOf(movie);
  for (const connection of movie.data.connections) {
    if (!filmIds.has(connection.slug)) continue;
    relationLinks.set(keyFor(from, connection.slug), {
      source: `film:${from}`,
      target: `film:${connection.slug}`,
      type: 'idea',
      note: connection.note,
    });
  }
}

for (let i = 0; i < movies.length; i++) {
  for (let j = i + 1; j < movies.length; j++) {
    const a = movies[i]!;
    const b = movies[j]!;
    const aSlug = slugOf(a);
    const bSlug = slugOf(b);
    if (relationLinks.has(keyFor(aSlug, bSlug))) continue;
    const shared = a.data.tags.filter((tag) => b.data.tags.includes(tag));
    if (shared.length === 0) continue;
    relationLinks.set(keyFor(aSlug, bSlug), {
      source: `film:${aSlug}`,
      target: `film:${bSlug}`,
      type: 'theme',
      note: `${t('map.shareNote')}: ${shared.join(', ')}`,
    });
  }
}

const membershipLinks = directors.flatMap((director) =>
  director.films.map((film) => ({
    source: `director:${director.slug}`,
    target: `film:${slugOf(film)}`,
    type: 'membership' as const,
    note: director.name,
  }))
);

const graph = {
  nodes: [...directorNodes, ...filmNodes],
  links: [...membershipLinks, ...relationLinks.values()],
};
const ideaCount = [...relationLinks.values()].filter((link) => link.type === 'idea').length;
const themeCount = [...relationLinks.values()].filter((link) => link.type === 'theme').length;

const config = {
  filmsBase: localizePath('/films/', lang),
  directorsBase: localizePath('/directors/', lang),
  filmLabel: t('map.filmLabel'),
  filmsLabel: t('map.filmsLabel'),
  ideaLabel: t('map.ideaLabel'),
  themeLabel: t('map.themeLabel'),
  noRelations: t('map.noRelations'),
  seeFilm: t('map.seeStudy'),
  seeDirector: t('map.seeDirector'),
  membershipLabel: t('map.membershipLabel'),
  referencesLabel: t('map.referencesLabel'),
  locate: t('map.locate'),
  openReference: t('map.openReference'),
  maximize: t('map.maximize'),
  minimize: t('map.minimize'),
};
---

<BaseLayout title={`${t('map.title')} — ${t('brand')}`} description={t('meta.map')} lang={lang}>
  <section class="wrap map-intro">
    <div class="map-heading">
      <p class="eyebrow">{t('map.eyebrow')}</p>
      <h1>{t('map.title')}</h1>
    </div>
    <div class="map-intro-copy">
      <p>{t('map.intro')}</p>
      <dl class="map-stats" aria-label={t('map.summary')}>
        <div>
          <dt>{t('map.directorsCount')}</dt>
          <dd>{String(directors.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>{t('map.filmsCount')}</dt>
          <dd>{String(movies.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>{t('map.linksCount')}</dt>
          <dd>{String(ideaCount).padStart(2, '0')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap map-wrap" id="map-workspace">
    <div class="map-toolbar" aria-label={t('map.layers')}>
      <div class="map-toolbar-copy">
        <span class="map-toolbar-index">01</span>
        <div>
          <strong>{t('map.readingTitle')}</strong>
          <span>{t('map.readingHelp')}</span>
        </div>
      </div>
      <div class="layer-controls">
        <button class="layer-button is-active" type="button" data-layer="idea" aria-pressed="true">
          <i class="legend-line idea"></i><span>{t('map.ideas')}</span><b>{String(ideaCount).padStart(2, '0')}</b>
        </button>
        <button class="layer-button" type="button" data-layer="theme" aria-pressed="false">
          <i class="legend-line theme"></i><span>{t('map.themes')}</span><b>{String(themeCount).padStart(2, '0')}</b>
        </button>
      </div>
      <div class="map-tools" aria-label={t('map.find')}>
        <label class="map-search" for="map-search">
          <span>{t('map.searchLabel')}</span>
          <input
            id="map-search"
            type="search"
            list="map-node-options"
            placeholder={t('map.searchPlaceholder')}
            autocomplete="off"
          />
        </label>
        <datalist id="map-node-options">
          {graph.nodes.map((node) => <option value={node.title} />)}
        </datalist>
        <button class="map-tool-button map-reset" type="button" id="map-reset">
          <svg aria-hidden="true" viewBox="0 0 20 20">
            <path d="M15.8 6.2A7 7 0 1 0 17 10M15.8 6.2V2.8m0 3.4h-3.4" />
          </svg>
          <span>{t('map.resetView')}</span>
        </button>
        <button
          class="map-tool-button map-expand"
          type="button"
          id="map-expand"
          aria-expanded="false"
          aria-controls="map-workspace"
        >
          <svg class="expand-icon" aria-hidden="true" viewBox="0 0 20 20">
            <path d="M7.2 3H3v4.2M12.8 3H17v4.2M7.2 17H3v-4.2M12.8 17H17v-4.2" />
          </svg>
          <span id="map-expand-label">{t('map.maximize')}</span>
        </button>
      </div>
    </div>

    <div class="map-shell">
      <div class="map-stage">
        <svg id="graph" role="img" aria-label={t('map.svgLabel')}></svg>
        <div class="map-stage-label" aria-hidden="true">
          <span>{t('map.fieldLabel')}</span>
          <b>{String(graph.nodes.length).padStart(2, '0')}</b>
        </div>
        <div class="map-hints" aria-hidden="true">
          <span>{t('map.drag')}</span>
          <span>{t('map.zoom')}</span>
        </div>
      </div>

      <aside class="map-panel" id="panel" aria-live="polite">
        <div class="panel-head">
          <span id="panel-kind">{t('map.memoryFile')}</span>
          <button class="panel-close" id="panel-close" aria-label={t('map.close')}>×</button>
        </div>
        <div class="panel-visual" id="panel-visual"><span id="panel-initial">S</span></div>
        <p class="panel-kicker" id="panel-kicker">{t('map.selectNode')}</p>
        <h2 id="panel-title">{t('brand')}</h2>
        <p class="panel-desc" id="panel-desc">{t('map.placeholderDesc')}</p>
        <div class="panel-tags" id="panel-tags"></div>
        <a class="panel-link" id="panel-link" href={localizePath('/', lang)}>{t('map.seeStudy')}</a>
        <div class="panel-relations">
          <div class="panel-relations-head">
            <h3 id="panel-relations-title">{t('map.related')}</h3>
            <span id="panel-relations-count">00</span>
          </div>
          <ul class="panel-conns" id="panel-conns"></ul>
        </div>
      </aside>
    </div>
  </section>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)} />
  <script type="application/json" id="map-config" set:html={JSON.stringify(config)} />

  <script>
    import * as d3 from 'd3';

    type FilmNode = {
      id: string;
      slug: string;
      kind: 'film';
      title: string;
      director: string;
      directorSlug: string;
      year: number;
      logline: string;
      tags: string[];
      frame: string | null;
      x?: number;
      y?: number;
      fx?: number | null;
      fy?: number | null;
    };
    type DirectorNode = {
      id: string;
      slug: string;
      kind: 'director';
      title: string;
      worldview: string;
      obsessions: string[];
      filmIds: string[];
      x?: number;
      y?: number;
      fx?: number | null;
      fy?: number | null;
    };
    type GraphNode = FilmNode | DirectorNode;
    type Link = {
      source: string | GraphNode;
      target: string | GraphNode;
      type: 'membership' | 'idea' | 'theme';
      note: string;
    };

    const dataEl = document.getElementById('graph-data');
    const configEl = document.getElementById('map-config');
    if (dataEl && configEl) {
      const graph = JSON.parse(dataEl.textContent || '{}') as { nodes: GraphNode[]; links: Link[] };
      const config = JSON.parse(configEl.textContent || '{}') as {
        filmsBase: string;
        directorsBase: string;
        filmLabel: string;
        filmsLabel: string;
        ideaLabel: string;
        themeLabel: string;
        noRelations: string;
        seeFilm: string;
        seeDirector: string;
        membershipLabel: string;
        referencesLabel: string;
        locate: string;
        openReference: string;
        maximize: string;
        minimize: string;
      };
      const svgEl = document.getElementById('graph') as unknown as SVGSVGElement;
      const panel = document.getElementById('panel')!;
      const workspace = document.getElementById('map-workspace')!;
      const expandButton = document.getElementById('map-expand') as HTMLButtonElement;
      const expandLabel = document.getElementById('map-expand-label')!;
      const nodes = graph.nodes;
      const links = graph.links;
      const idOf = (node: string | GraphNode) => (typeof node === 'string' ? node : node.id);
      const filmSize = { width: 112, height: 84 };
      const filmTitleLines = (title: string) => {
        const words = title.split(/\s+/);
        const lineCount = Math.min(3, words.length, Math.max(1, Math.ceil(title.length / 18)));
        if (lineCount === 1) return [title];

        let best: string[] = [];
        let bestScore = Number.POSITIVE_INFINITY;
        const partition = (start: number, lines: string[]) => {
          if (lines.length === lineCount - 1) {
            const candidate = [...lines, words.slice(start).join(' ')];
            const lengths = candidate.map((line) => line.length);
            const score = Math.max(...lengths) * 100 + Math.max(...lengths) - Math.min(...lengths);
            if (score < bestScore) {
              best = candidate;
              bestScore = score;
            }
            return;
          }
          const wordsStillNeeded = lineCount - lines.length - 1;
          for (let end = start + 1; end <= words.length - wordsStillNeeded; end += 1) {
            partition(end, [...lines, words.slice(start, end).join(' ')]);
          }
        };
        partition(0, []);
        return best;
      };

      let width = svgEl.clientWidth || 900;
      let height = svgEl.clientHeight || Math.max(650, Math.round(width * 0.68));
      const svg = d3.select(svgEl).attr('viewBox', `0 0 ${width} ${height}`);
      const container = svg.append('g');
      const zoomBehavior = d3
        .zoom<SVGSVGElement, unknown>()
        .scaleExtent([0.45, 2.8])
        .on('zoom', (event) => container.attr('transform', event.transform.toString()));
      svg.call(
        zoomBehavior
      );

      const link = container
        .append('g')
        .attr('class', 'links')
        .selectAll<SVGLineElement, Link>('line')
        .data(links)
        .join('line')
        .attr('class', (item) => `edge edge-${item.type}`)
        .classed('is-hidden', (item) => item.type === 'theme');

      const labelFor = (item: Link) =>
        item.type === 'idea'
          ? config.ideaLabel
          : item.type === 'theme'
            ? config.themeLabel
            : config.membershipLabel;
      const relationLabel = container
        .append('g')
        .attr('class', 'edge-labels')
        .selectAll<SVGGElement, Link>('g')
        .data(links)
        .join('g')
        .attr('class', (item) => `edge-label edge-label-${item.type}`)
        .attr('aria-hidden', 'true');
      relationLabel
        .append('rect')
        .attr('x', (item) => -(Math.max(46, labelFor(item).length * 5.2 + 18) / 2))
        .attr('y', -11)
        .attr('width', (item) => Math.max(46, labelFor(item).length * 5.2 + 18))
        .attr('height', 22)
        .attr('rx', 11);
      relationLabel
        .append('text')
        .attr('dy', '0.34em')
        .text(labelFor);

      const node = container
        .append('g')
        .attr('class', 'nodes')
        .selectAll<SVGGElement, GraphNode>('g')
        .data(nodes)
        .join('g')
        .attr('class', (item) => `node node-${item.kind}`)
        .attr('role', 'button')
        .attr('tabindex', 0)
        .attr('aria-label', (item) => item.title)
        .style('cursor', 'pointer');

      const directors = node.filter((item) => item.kind === 'director');
      directors.append('circle').attr('class', 'director-halo').attr('r', 76);
      directors.append('circle').attr('class', 'director-core').attr('r', 51);
      directors
        .append('text')
        .attr('class', 'director-name')
        .attr('y', -4)
        .text((item) => item.title.split(' ').at(-1) ?? item.title);
      directors
        .append('text')
        .attr('class', 'director-count')
        .attr('y', 17)
        .text((item) => {
          const director = item as DirectorNode;
          const label = director.filmIds.length === 1 ? config.filmLabel : config.filmsLabel;
          return `${director.filmIds.length} ${label}`;
        });

      const films = node.filter((item) => item.kind === 'film');
      films
        .append('rect')
        .attr('class', 'film-shadow')
        .attr('x', -filmSize.width / 2 + 5)
        .attr('y', -filmSize.height / 2 + 7)
        .attr('width', filmSize.width)
        .attr('height', filmSize.height);
      films
        .append('rect')
        .attr('class', 'film-card')
        .attr('x', -filmSize.width / 2)
        .attr('y', -filmSize.height / 2)
        .attr('width', filmSize.width)
        .attr('height', filmSize.height);
      films
        .append('image')
        .attr('class', 'film-image')
        .attr('href', (item) => (item as FilmNode).frame ?? '')
        .attr('x', -filmSize.width / 2 + 6)
        .attr('y', -filmSize.height / 2 + 6)
        .attr('width', filmSize.width - 12)
        .attr('height', 52)
        .attr('preserveAspectRatio', 'xMidYMid slice')
        .classed('has-image', (item) => Boolean((item as FilmNode).frame));
      films
        .append('text')
        .attr('class', 'film-initial')
        .attr('y', -2)
        .text((item) => item.title.charAt(0));
      films
        .append('text')
        .attr('class', 'film-title')
        .each(function (item) {
          const lines = filmTitleLines(item.title);
          const longestLine = Math.max(...lines.map((line) => line.length));
          const fontSize = longestLine > 21 ? 7 : longestLine > 18 ? 8 : 9;
          const lineHeight = fontSize + 1;
          const firstBaseline = filmSize.height / 2 - 10 - ((lines.length - 1) * lineHeight) / 2;
          d3.select(this)
            .style('font-size', `${fontSize}px`)
            .selectAll('tspan')
            .data(lines)
            .join('tspan')
            .attr('x', 0)
            .attr('y', (_, index) => firstBaseline + index * lineHeight)
            .text((line) => line);
        });
      films
        .append('text')
        .attr('class', 'film-year')
        .attr('y', filmSize.height / 2 + 16)
        .text((item) => String((item as FilmNode).year));

      const simulation = d3
        .forceSimulation<GraphNode>(nodes)
        .force(
          'link',
          d3
            .forceLink<GraphNode, Link>(links)
            .id((item) => item.id)
            .distance((item) => (item.type === 'membership' ? 145 : item.type === 'idea' ? 250 : 300))
            .strength((item) => (item.type === 'membership' ? 0.92 : item.type === 'idea' ? 0.14 : 0.025))
        )
        .force('charge', d3.forceManyBody().strength((item) => (item.kind === 'director' ? -1150 : -360)))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collide', d3.forceCollide<GraphNode>().radius((item) => (item.kind === 'director' ? 94 : 74)))
        .on('tick', () => {
          link
            .attr('x1', (item) => (item.source as GraphNode).x!)
            .attr('y1', (item) => (item.source as GraphNode).y!)
            .attr('x2', (item) => (item.target as GraphNode).x!)
            .attr('y2', (item) => (item.target as GraphNode).y!);
          relationLabel.attr(
            'transform',
            (item) =>
              `translate(${((item.source as GraphNode).x! + (item.target as GraphNode).x!) / 2},${
                ((item.source as GraphNode).y! + (item.target as GraphNode).y!) / 2
              })`
          );
          node.attr('transform', (item) => `translate(${item.x},${item.y})`);
        });

      node.call(
        d3
          .drag<SVGGElement, GraphNode>()
          .on('start', (event, item) => {
            if (!event.active) simulation.alphaTarget(0.25).restart();
            item.fx = item.x;
            item.fy = item.y;
          })
          .on('drag', (event, item) => {
            item.fx = event.x;
            item.fy = event.y;
          })
          .on('end', (event, item) => {
            if (!event.active) simulation.alphaTarget(0);
            item.fx = null;
            item.fy = null;
          })
      );

      const activeLayers = new Set(['membership', 'idea']);
      let selected: string | null = null;

      function focusNode(item: GraphNode | undefined) {
        if (!item || typeof item.x !== 'number' || typeof item.y !== 'number') return;
        const scale = width < 620 ? 0.72 : 0.92;
        const transform = d3.zoomIdentity
          .translate(width / 2 - item.x * scale, height / 2 - item.y * scale)
          .scale(scale);
        svg.transition().duration(500).call(zoomBehavior.transform, transform);
      }

      function resetView() {
        svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity);
        simulation.alpha(0.18).restart();
      }

      function relatedLinks(id: string) {
        return links.filter(
          (item) =>
            activeLayers.has(item.type) && (idOf(item.source) === id || idOf(item.target) === id)
        );
      }

      function allRelatedLinks(id: string) {
        return links.filter((item) => idOf(item.source) === id || idOf(item.target) === id);
      }

      function select(id: string | null, focus = false) {
        selected = id;
        if (!id) {
          node.classed('is-dim', false).classed('is-active', false).classed('is-near', false);
          link.classed('is-dim', false).classed('is-hot', false);
          relationLabel.classed('is-visible', false);
          panel.classList.remove('is-filled');
          return;
        }
        const near = new Set<string>();
        for (const item of relatedLinks(id)) {
          near.add(idOf(item.source) === id ? idOf(item.target) : idOf(item.source));
        }
        node.classed('is-active', (item) => item.id === id);
        node.classed('is-near', (item) => near.has(item.id));
        node.classed('is-dim', (item) => item.id !== id && !near.has(item.id));
        link.classed(
          'is-hot',
          (item) =>
            activeLayers.has(item.type) && (idOf(item.source) === id || idOf(item.target) === id)
        );
        link.classed(
          'is-dim',
          (item) =>
            !activeLayers.has(item.type) || (idOf(item.source) !== id && idOf(item.target) !== id)
        );
        relationLabel.classed(
          'is-visible',
          (item) =>
            activeLayers.has(item.type) && (idOf(item.source) === id || idOf(item.target) === id)
        );
        fillPanel(id);
        if (focus) focusNode(nodes.find((item) => item.id === id));
      }

      function setTags(tags: string[]) {
        const tagsEl = document.getElementById('panel-tags')!;
        tagsEl.replaceChildren();
        for (const tag of tags) {
          const span = document.createElement('span');
          span.className = 'tag';
          span.textContent = tag;
          tagsEl.appendChild(span);
        }
      }

      function addRelation({
        nodeId,
        title,
        detail,
        href,
        type,
      }: {
        nodeId: string;
        title: string;
        detail: string;
        href: string;
        type: Link['type'];
      }) {
        const li = document.createElement('li');
        li.className = `relation-card relation-${type}`;
        const focus = document.createElement('button');
        focus.className = 'relation-focus';
        focus.type = 'button';
        focus.setAttribute('aria-label', `${config.locate}: ${title}`);
        focus.addEventListener('click', () => select(nodeId, true));
        const badge = document.createElement('span');
        badge.className = 'relation-type';
        badge.textContent =
          type === 'idea'
            ? config.ideaLabel
            : type === 'theme'
              ? config.themeLabel
              : config.membershipLabel;
        const copy = document.createElement('span');
        copy.className = 'relation-copy';
        const strong = document.createElement('strong');
        strong.textContent = title;
        const note = document.createElement('span');
        note.className = 'why';
        note.textContent = detail;
        copy.append(strong, note);
        const marker = document.createElement('span');
        marker.className = 'relation-marker';
        marker.setAttribute('aria-hidden', 'true');
        marker.textContent = '⌖';
        focus.append(badge, copy, marker);
        const anchor = document.createElement('a');
        anchor.href = href;
        anchor.className = 'relation-open';
        anchor.textContent = config.openReference;
        li.append(focus, anchor);
        document.getElementById('panel-conns')!.appendChild(li);
      }

      function fillPanel(id: string) {
        const current = nodes.find((item) => item.id === id)!;
        const list = document.getElementById('panel-conns')!;
        const visual = document.getElementById('panel-visual')!;
        const initial = document.getElementById('panel-initial')!;
        const linkEl = document.getElementById('panel-link') as HTMLAnchorElement;
        const relationTitle = document.getElementById('panel-relations-title')!;
        const relationCount = document.getElementById('panel-relations-count')!;
        list.replaceChildren();
        visual.style.backgroundImage = '';
        visual.classList.toggle('is-director', current.kind === 'director');
        initial.textContent = current.title.charAt(0);
        document.getElementById('panel-title')!.textContent = current.title;

        if (current.kind === 'director') {
          document.getElementById('panel-kind')!.textContent = config.seeDirector;
          document.getElementById('panel-kicker')!.textContent = `${current.filmIds.length} ${
            current.filmIds.length === 1 ? config.filmLabel : config.filmsLabel
          }`;
          document.getElementById('panel-desc')!.textContent = `“${current.worldview}”`;
          setTags(current.obsessions);
          linkEl.href = `${config.directorsBase}${current.slug}/`;
          linkEl.textContent = config.seeDirector;
          relationTitle.textContent = config.membershipLabel;
          for (const filmId of current.filmIds) {
            const film = nodes.find((item): item is FilmNode => item.id === filmId && item.kind === 'film');
            if (!film) continue;
            addRelation({
              nodeId: film.id,
              title: film.title,
              detail: String(film.year),
              href: `${config.filmsBase}${film.slug}/`,
              type: 'membership',
            });
          }
        } else {
          document.getElementById('panel-kind')!.textContent = config.filmLabel;
          document.getElementById('panel-kicker')!.textContent = `${current.year} · ${current.director}`;
          document.getElementById('panel-desc')!.textContent = `“${current.logline}”`;
          setTags(current.tags);
          if (current.frame) visual.style.backgroundImage = `url("${current.frame}")`;
          linkEl.href = `${config.filmsBase}${current.slug}/`;
          linkEl.textContent = config.seeFilm;
          relationTitle.textContent = config.referencesLabel;
          addRelation({
            nodeId: `director:${current.directorSlug}`,
            title: current.director,
            detail: config.seeDirector,
            href: `${config.directorsBase}${current.directorSlug}/`,
            type: 'membership',
          });
          const relations = allRelatedLinks(current.id).filter((item) => item.type !== 'membership');
          for (const relation of relations) {
            const otherId = idOf(relation.source) === current.id ? idOf(relation.target) : idOf(relation.source);
            const other = nodes.find((item) => item.id === otherId);
            if (!other) continue;
            addRelation({
              nodeId: other.id,
              title: other.title,
              detail: relation.note,
              href: other.kind === 'film'
                ? `${config.filmsBase}${other.slug}/`
                : `${config.directorsBase}${other.slug}/`,
              type: relation.type,
            });
          }
        }
        const relationTotal = list.children.length;
        relationCount.textContent = String(relationTotal).padStart(2, '0');
        if (relationTotal === 0) {
          const empty = document.createElement('li');
          empty.className = 'empty-relation';
          empty.textContent = config.noRelations;
          list.appendChild(empty);
        }
        panel.classList.add('is-filled');
        panel.scrollTo({ top: 0 });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-layer]').forEach((button) => {
        button.addEventListener('click', () => {
          const layer = button.dataset.layer!;
          const enabled = !activeLayers.has(layer);
          if (enabled) activeLayers.add(layer);
          else activeLayers.delete(layer);
          button.classList.toggle('is-active', enabled);
          button.setAttribute('aria-pressed', String(enabled));
          link.filter((item) => item.type === layer).classed('is-hidden', !enabled);
          if (selected) select(selected);
        });
      });

      const normalize = (value: string) =>
        value
          .toLowerCase()
          .normalize('NFD')
          .replace(/\p{Diacritic}/gu, '')
          .trim();
      const searchInput = document.getElementById('map-search') as HTMLInputElement | null;
      searchInput?.addEventListener('input', () => {
        const query = normalize(searchInput.value);
        if (!query) {
          node.classed('is-search-hit', false);
          return;
        }
        const hits = new Set(
          nodes
            .filter((item) => normalize(item.title).includes(query))
            .map((item) => item.id)
        );
        node.classed('is-search-hit', (item) => hits.has(item.id));
      });
      searchInput?.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        const query = normalize(searchInput.value);
        const match = nodes.find((item) => normalize(item.title).includes(query));
        if (!match) return;
        searchInput.value = match.title;
        select(match.id, true);
      });
      searchInput?.addEventListener('change', () => {
        const query = normalize(searchInput.value);
        const match =
          nodes.find((item) => normalize(item.title) === query) ??
          nodes.find((item) => normalize(item.title).includes(query));
        if (!match) return;
        searchInput.value = match.title;
        select(match.id, true);
      });
      document.getElementById('map-reset')?.addEventListener('click', () => {
        searchInput && (searchInput.value = '');
        node.classed('is-search-hit', false);
        select(null);
        resetView();
      });

      function resizeGraph() {
        const nextWidth = svgEl.clientWidth;
        const nextHeight = svgEl.clientHeight;
        if (!nextWidth || !nextHeight) return;
        width = nextWidth;
        height = nextHeight;
        svg.attr('viewBox', `0 0 ${width} ${height}`);
        simulation.force('center', d3.forceCenter(width / 2, height / 2));
        simulation.alpha(0.2).restart();
      }

      function setExpanded(expanded: boolean) {
        workspace.classList.toggle('is-expanded', expanded);
        document.body.classList.toggle('map-is-expanded', expanded);
        expandButton.classList.toggle('is-active', expanded);
        expandButton.setAttribute('aria-expanded', String(expanded));
        expandLabel.textContent = expanded ? config.minimize : config.maximize;
        requestAnimationFrame(() => {
          resizeGraph();
          if (selected) focusNode(nodes.find((item) => item.id === selected));
        });
        window.setTimeout(() => {
          if (selected && workspace.classList.contains('is-expanded')) {
            focusNode(nodes.find((item) => item.id === selected));
          }
        }, 450);
      }

      expandButton.addEventListener('click', () => {
        setExpanded(!workspace.classList.contains('is-expanded'));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !workspace.classList.contains('is-expanded')) return;
        setExpanded(false);
        expandButton.focus();
      });

      node.on('click', (event, item) => {
        event.stopPropagation();
        select(selected === item.id ? null : item.id);
      });
      node.on('keydown', (event, item) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        event.stopPropagation();
        select(item.id, true);
      });
      svg.on('click', () => select(null));
      document.getElementById('panel-close')!.addEventListener('click', () => select(null));

      const hashId = decodeURIComponent(window.location.hash.slice(1));
      const initial = nodes.find((item) => item.id === hashId) ?? nodes.find((item) => item.kind === 'director');
      if (initial) select(initial.id);

      const resizeObserver = new ResizeObserver(resizeGraph);
      resizeObserver.observe(svgEl);
      workspace.dataset.mapReady = 'true';
    }
  </script>
</BaseLayout>

