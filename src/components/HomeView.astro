---
import BaseLayout from '../layouts/BaseLayout.astro';
import MovieCard from './MovieCard.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getMovies } from '../lib/movies';
import { getDirectors } from '../lib/directors';
import { caseNo } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const movies = await getMovies(lang);
const directors = await getDirectors(lang);
const countries = new Set(movies.map((movie) => movie.data.country).filter(Boolean));

// Case numbers stay global and chronological (newest = highest), even though
// the archive is laid out by director.
const caseIndexById = new Map(movies.map((m, i) => [m.id, movies.length - i]));
---

<BaseLayout title={t('brand')} description={t('meta.home')} lang={lang}>
  <section class="wrap intro home-hero" id="about">
    <div class="hero-gunfire" aria-hidden="true"></div>
    <div class="hero-marquee" aria-hidden="true">
      <span>{caseNo(movies.length)} · {t('home.archiveTag')}</span>
      <span>EST. MMXXVI</span>
    </div>
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1>{t('home.title.a')} <span>{t('home.title.b')}</span></h1>
    <div class="editorial-divider" aria-hidden="true">
      <i></i>
      <b></b>
      <i></i>
    </div>
    <p>{t('home.intro')}</p>
    <div class="hero-scroll" aria-hidden="true">
      <span>{t('home.scroll')}</span>
      <i></i>
    </div>
  </section>

  <section class="wrap archive-section" aria-label={t('home.archiveLabel')}>
    {
      directors.map((director) => {
        const countLabel =
          director.films.length === 1 ? t('director.study') : t('director.studies');
        return (
          <div class="director-block">
            <header class="director-block-head">
              <a href={localizePath(`/directors/${director.slug}/`, lang)}>
                <h2>{director.name}</h2>
              </a>
              <span class="director-block-count">
                {director.films.length} {countLabel}
              </span>
              {director.entry && (
                <p class="director-block-worldview">"{director.entry.data.worldview}"</p>
              )}
            </header>
            <div class="movie-grid">
              {director.films.map((movie) => (
                <MovieCard movie={movie} index={caseIndexById.get(movie.id)} lang={lang} />
              ))}
            </div>
          </div>
        );
      })
    }
  </section>

  <section class="wrap editorial-note">
    <div class="note-copy">
      <h2>"{t('home.quote')}"</h2>
      <p>{t('home.note')}</p>
    </div>
    <div class="note-stats" aria-label={t('home.summaryLabel')}>
      <div>
        <strong>{movies.length}</strong>
        <span>{t('home.stat.studies')}</span>
      </div>
      <div>
        <strong>{directors.length}</strong>
        <span>{t('home.stat.directors')}</span>
      </div>
      <div>
        <strong>{countries.size}</strong>
        <span>{t('home.stat.countries')}</span>
      </div>
    </div>
  </section>

  <style>
    .director-block {
      margin-bottom: 4rem;
    }

    .director-block:last-child {
      margin-bottom: 0;
    }

    .director-block-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 1rem;
      border-top: 1px solid var(--border);
      margin-bottom: 1.8rem;
      padding-top: 1.6rem;
    }

    .director-block-head a {
      color: var(--text);
    }

    .director-block-head h2 {
      margin: 0;
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      font-weight: 700;
      transition: color 0.2s ease;
    }

    .director-block-head a:hover h2 {
      color: var(--accent);
    }

    .director-block-count {
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .director-block-worldview {
      flex-basis: 100%;
      max-width: 52rem;
      margin: 0.2rem 0 0;
      color: var(--text-soft);
      font-family: var(--font-serif);
      font-size: 1rem;
      font-style: italic;
      line-height: 1.5;
    }
  </style>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      document.documentElement.classList.add('js-anim');

      // 4 — cards are "shot into" the archive as they scroll into view
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.movie-grid .card'));
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const card = entry.target as HTMLElement;
            const delay = Number(card.dataset.delay ?? 0);
            window.setTimeout(() => card.classList.add('is-hit'), delay);
            io.unobserve(card);
          }
        },
        { threshold: 0.18 }
      );
      cards.forEach((card, i) => {
        card.dataset.delay = String((i % 3) * 90);
        io.observe(card);
      });

      // 3 — click inside the hero leaves a bullet hole + muzzle flash + recoil
      const hero = document.querySelector<HTMLElement>('.home-hero');
      if (hero) {
        const flash = document.createElement('div');
        flash.className = 'muzzle-screen-flash';
        document.body.appendChild(flash);

        const bulletSvg = `<svg viewBox="0 0 100 100" width="46" height="46" aria-hidden="true">
          <circle cx="50" cy="50" r="26" fill="rgba(0,0,0,0.55)"/>
          <g stroke="rgba(255,255,255,0.5)" stroke-width="1.4" fill="none">
            <path d="M50 50 L82 28 M50 50 L88 60 M50 50 L58 90 M50 50 L18 78 M50 50 L10 46 M50 50 L36 12"/>
          </g>
          <circle cx="50" cy="50" r="8.5" fill="#000" stroke="rgba(255,255,255,0.85)" stroke-width="2"/>
        </svg>`;

        hero.addEventListener('click', (ev) => {
          // ignore clicks on links/buttons inside the hero
          if ((ev.target as HTMLElement).closest('a, button')) return;
          const rect = hero.getBoundingClientRect();
          const hole = document.createElement('span');
          hole.className = 'bullet-hole';
          hole.style.left = `${ev.clientX - rect.left}px`;
          hole.style.top = `${ev.clientY - rect.top}px`;
          hole.innerHTML = bulletSvg;
          hero.appendChild(hole);

          flash.classList.remove('fire');
          void flash.offsetWidth;
          flash.classList.add('fire');

          hero.classList.remove('hero-shake');
          void hero.offsetWidth;
          hero.classList.add('hero-shake');

          window.setTimeout(() => hole.remove(), 3800);
        });
      }
    }
  </script>
</BaseLayout>
