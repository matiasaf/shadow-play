---
import BaseLayout from '../layouts/BaseLayout.astro';
import MovieCard from './MovieCard.astro';
import MovieRow from './MovieRow.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getMovies, slugOf, type MovieEntry } from '../lib/movies';
import { getDirectors, type DirectorGroup } from '../lib/directors';
import { caseNo } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const movies = await getMovies(lang);
const directors = await getDirectors(lang);
const countries = new Set(movies.map((movie) => movie.data.country).filter(Boolean));
const countryOptions = [...countries].sort((a, b) => String(a).localeCompare(String(b)));
const latestMovie = movies[0];

// Case numbers stay global and chronological (newest = highest), even though
// the archive is laid out by director.
const caseIndexById = new Map(movies.map((m, i) => [m.id, movies.length - i]));

type DashboardGroup = {
  id: string;
  title: string;
  href?: string;
  meta: string;
  note?: string;
  films: MovieEntry[];
  sortAlpha: string;
  sortCount: number;
  sortRecency: number;
};

const dateFormatter = new Intl.DateTimeFormat(lang === 'es' ? 'es-AR' : 'en', {
  month: 'long',
  year: 'numeric',
});

function newestTimestamp(films: MovieEntry[]): number {
  return Math.max(...films.map((film) => film.data.watchedOn.valueOf()));
}

function groupMeta(films: MovieEntry[]): string {
  const countLabel = films.length === 1 ? t('director.study') : t('director.studies');
  return `${films.length} ${countLabel}`;
}

function movieAttrs(movie: MovieEntry) {
  return {
    'data-director': movie.data.director,
    'data-tags': movie.data.tags.join('|'),
    'data-country': movie.data.country ?? '',
    'data-year': String(movie.data.year),
  };
}

const directorGroups: DashboardGroup[] = directors.map((director: DirectorGroup) => ({
  id: director.slug,
  title: director.name,
  href: localizePath(`/directors/${director.slug}/`, lang),
  meta: groupMeta(director.films),
  note: director.entry?.data.worldview,
  films: director.films,
  sortAlpha: director.name,
  sortCount: director.films.length,
  sortRecency: newestTimestamp(director.films),
}));

const tagMap = new Map<string, MovieEntry[]>();
for (const movie of movies) {
  for (const tag of movie.data.tags) {
    const films = tagMap.get(tag) ?? [];
    films.push(movie);
    tagMap.set(tag, films);
  }
}
const themeGroups: DashboardGroup[] = [...tagMap.entries()]
  .map(([tag, films]) => ({
    id: tag,
    title: tag,
    meta: groupMeta(films),
    films,
    sortAlpha: tag,
    sortCount: films.length,
    sortRecency: newestTimestamp(films),
  }))
  .sort((a, b) => b.sortCount - a.sortCount || a.sortAlpha.localeCompare(b.sortAlpha));
const themeOptions = themeGroups.map((group) => group.title);

const journalMap = new Map<string, MovieEntry[]>();
for (const movie of movies) {
  const key = `${movie.data.watchedOn.getFullYear()}-${String(
    movie.data.watchedOn.getMonth() + 1
  ).padStart(2, '0')}`;
  const films = journalMap.get(key) ?? [];
  films.push(movie);
  journalMap.set(key, films);
}
const journalGroups: DashboardGroup[] = [...journalMap.entries()]
  .map(([key, films]) => ({
    id: key,
    title: dateFormatter.format(films[0]!.data.watchedOn),
    meta: groupMeta(films),
    films,
    sortAlpha: key,
    sortCount: films.length,
    sortRecency: newestTimestamp(films),
  }))
  .sort((a, b) => b.sortRecency - a.sortRecency);

function decadeLabel(year: number): string {
  const decade = Math.floor(year / 10) * 10;
  return lang === 'es' ? `Años ${decade}` : `${decade}s`;
}

const timelineMap = new Map<string, MovieEntry[]>();
for (const movie of [...movies].sort((a, b) => b.data.year - a.data.year)) {
  const key = String(Math.floor(movie.data.year / 10) * 10);
  const films = timelineMap.get(key) ?? [];
  films.push(movie);
  timelineMap.set(key, films);
}
const timelineGroups: DashboardGroup[] = [...timelineMap.entries()]
  .map(([key, films]) => ({
    id: key,
    title: decadeLabel(Number(key)),
    meta: groupMeta(films),
    films,
    sortAlpha: key,
    sortCount: films.length,
    sortRecency: Number(key),
  }))
  .sort((a, b) => b.sortRecency - a.sortRecency);

const connectionGroups: DashboardGroup[] = movies
  .filter((movie) => movie.data.connections.length > 0)
  .map((movie) => ({
    id: slugOf(movie),
    title: movie.data.title,
    href: localizePath(`/films/${slugOf(movie)}/`, lang),
    meta: `${movie.data.connections.length} ${
      movie.data.connections.length === 1
        ? t('dashboard.connection')
        : t('dashboard.connections')
    }`,
    note: movie.data.connections.map((connection) => connection.note).join(' '),
    films: [movie],
    sortAlpha: movie.data.title,
    sortCount: movie.data.connections.length,
    sortRecency: movie.data.watchedOn.valueOf(),
  }));

const dashboardViews = [
  { id: 'directors', label: t('dashboard.view.directors'), groups: directorGroups },
  { id: 'themes', label: t('dashboard.view.themes'), groups: themeGroups },
  { id: 'journal', label: t('dashboard.view.journal'), groups: journalGroups },
  { id: 'timeline', label: t('dashboard.view.timeline'), groups: timelineGroups },
  { id: 'connections', label: t('dashboard.view.connections'), groups: connectionGroups },
];

// Translated strings the client script needs (same pattern as MapView's #map-config).
const dashboardConfig = {
  countOne: t('dashboard.count.one'),
  countOther: t('dashboard.count.other'),
};
---

<BaseLayout title={t('brand')} description={t('meta.home')} lang={lang}>
  <section class="wrap intro home-hero" id="about">
    <div class="hero-marquee">
      <span>{caseNo(movies.length)} · {t('home.archiveTag')}</span>
      <span>{directors.length} {t('home.stat.directors')}</span>
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t('home.eyebrow')}</p>
        <h1>{t('home.title.a')} <span>{t('home.title.b')}</span></h1>
        <p>{t('home.intro')}</p>
      </div>

      <aside class="hero-ledger" aria-label={t('home.summaryLabel')}>
        <div class="hero-ledger-row">
          <strong>{movies.length}</strong>
          <span>{t('home.stat.studies')}</span>
        </div>
        <div class="hero-ledger-row">
          <strong>{directors.length}</strong>
          <span>{t('home.stat.directors')}</span>
        </div>
        <div class="hero-ledger-row">
          <strong>{countries.size}</strong>
          <span>{t('home.stat.countries')}</span>
        </div>
        {
          latestMovie && (
            <a class="latest-file" href={localizePath(`/films/${slugOf(latestMovie)}/`, lang)}>
              <span>{t('home.latest')}</span>
              <strong>{latestMovie.data.title}</strong>
              <small>{latestMovie.data.director} · {latestMovie.data.year}</small>
            </a>
          )
        }
      </aside>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span>{t('home.scroll')}</span>
      <i></i>
    </div>
  </section>

  <section
    class="wrap archive-section dashboard"
    id="archive"
    aria-label={t('home.archiveLabel')}
    data-density="grid"
  >
    <header class="dashboard-head">
      <div>
        <p class="eyebrow">{t('dashboard.eyebrow')}</p>
        <h2>{t('dashboard.title')}</h2>
        <p>{t('dashboard.intro')}</p>
      </div>
      <div class="dashboard-head-side">
        <div class="dashboard-stamp" aria-hidden="true">
          <span>{caseNo(movies.length)}</span>
          <strong>{dashboardViews.length}</strong>
          <small>{t('dashboard.viewLabel')}</small>
        </div>
          <div class="density-switch" role="group" aria-label={t('dashboard.density.label')}>
            <button type="button" data-density-button="grid" aria-pressed="true">
              <svg aria-hidden="true" viewBox="0 0 12 12" width="11" height="11">
                <rect x="0.5" y="0.5" width="4.5" height="4.5" fill="none" stroke="currentColor"></rect>
                <rect x="7" y="0.5" width="4.5" height="4.5" fill="none" stroke="currentColor"></rect>
                <rect x="0.5" y="7" width="4.5" height="4.5" fill="none" stroke="currentColor"></rect>
                <rect x="7" y="7" width="4.5" height="4.5" fill="none" stroke="currentColor"></rect>
              </svg>
              <span>{t('dashboard.density.grid')}</span>
            </button>
            <button type="button" data-density-button="list" aria-pressed="false">
              <svg aria-hidden="true" viewBox="0 0 12 12" width="11" height="11">
                <path d="M0 1.5h12M0 6h12M0 10.5h12" stroke="currentColor"></path>
              </svg>
              <span>{t('dashboard.density.list')}</span>
            </button>
          </div>
      </div>
    </header>

    <div class="dashboard-controls" aria-label={t('dashboard.controls')}>
      <div class="view-switcher" role="tablist" aria-label={t('dashboard.viewLabel')}>
        {
          dashboardViews.map((view, index) => (
            <button
              type="button"
              class="view-button"
              id={`dashboard-tab-${view.id}`}
              data-view-button={view.id}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              aria-controls={`dashboard-${view.id}`}
            >
              {view.label}
            </button>
          ))
        }
      </div>

      <div class="dashboard-filters">
        <label>
          <span>{t('dashboard.filter.director')}</span>
          <select data-dashboard-filter="director" autocomplete="off">
            <option value="">{t('dashboard.all')}</option>
            {directors.map((director) => <option value={director.name}>{director.name}</option>)}
          </select>
        </label>
        <label>
          <span>{t('dashboard.filter.theme')}</span>
          <select data-dashboard-filter="theme" autocomplete="off">
            <option value="">{t('dashboard.all')}</option>
            {themeOptions.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </label>
        <label>
          <span>{t('dashboard.filter.country')}</span>
          <select data-dashboard-filter="country" autocomplete="off">
            <option value="">{t('dashboard.all')}</option>
            {countryOptions.map((country) => <option value={country}>{country}</option>)}
          </select>
        </label>
        <label>
          <span>{t('dashboard.sort')}</span>
          <select data-dashboard-sort autocomplete="off">
            <option value="recency">{t('dashboard.sort.recency')}</option>
            <option value="count">{t('dashboard.sort.count')}</option>
            <option value="alpha">{t('dashboard.sort.alpha')}</option>
          </select>
        </label>
        <div class="dashboard-status">
          <p data-dashboard-count aria-live="polite"></p>
          <button type="button" class="dashboard-clear" data-dashboard-clear hidden>
            {t('dashboard.clear')}
          </button>
        </div>
      </div>
    </div>
    <script type="application/json" id="dashboard-config" set:html={JSON.stringify(dashboardConfig)} />

    <div class="dashboard-empty" data-dashboard-empty hidden>{t('dashboard.empty')}</div>

    {
      dashboardViews.map((view, index) => {
        // Only the default view is rendered live. The others are parsed but not
        // rendered (no layout, no image requests) until their tab is opened; the
        // script then swaps each template in once.
        const Wrap = index === 0 ? Fragment : 'template';
        const wrapProps = index === 0 ? {} : { 'data-panel-template': view.id };
        return (
          <div
            class="dashboard-panel"
            id={`dashboard-${view.id}`}
            data-dashboard-panel={view.id}
            role="tabpanel"
            aria-labelledby={`dashboard-tab-${view.id}`}
            hidden={index !== 0}
          >
            <Wrap {...wrapProps}>
              {view.groups.map((group) => (
                <section
                  class="dashboard-group"
                  data-dashboard-group
                  data-sort-alpha={group.sortAlpha.toLocaleLowerCase()}
                  data-sort-count={group.sortCount}
                  data-sort-recency={group.sortRecency}
                >
                  <header class="dashboard-group-head">
                    {group.href ? (
                      <a href={group.href}>
                        <h3>{group.title}</h3>
                      </a>
                    ) : (
                      <h3>{group.title}</h3>
                    )}
                    <span>{group.meta}</span>
                    {group.note && <p>"{group.note}"</p>}
                  </header>
                  <div class="movie-grid dashboard-grid">
                    {group.films.map((movie) => (
                      <div class="dashboard-card" {...movieAttrs(movie)}>
                        <MovieCard movie={movie} index={caseIndexById.get(movie.id)} lang={lang} />
                        <MovieRow movie={movie} index={caseIndexById.get(movie.id)} lang={lang} />
                      </div>
                    ))}
                  </div>
                </section>
              ))}
            </Wrap>
          </div>
        );
      })
    }
  </section>

  <section class="wrap editorial-note">
    <div class="note-copy">
      <h2>"{t('home.quote')}"</h2>
      <p>{t('home.note')}</p>
    </div>
    <div class="note-stats" aria-label={t('home.summaryLabel')}>
      <div>
        <strong>{movies.length}</strong>
        <span>{t('home.stat.studies')}</span>
      </div>
      <div>
        <strong>{directors.length}</strong>
        <span>{t('home.stat.directors')}</span>
      </div>
      <div>
        <strong>{countries.size}</strong>
        <span>{t('home.stat.countries')}</span>
      </div>
    </div>
  </section>

  <style>
    .archive-section {
      /* `/#archive` lands below the sticky site header. */
      scroll-margin-top: 5.5rem;
    }

    .dashboard-head {
      display: grid;
      grid-template-columns: minmax(0, 0.82fr) minmax(16rem, 0.34fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: end;
      margin-bottom: 2rem;
    }

    .dashboard-head .eyebrow {
      margin-bottom: 1.2rem;
    }

    .dashboard-head h2 {
      font-family: var(--font-serif);
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 900;
      line-height: 1;
      text-transform: uppercase;
    }

    .dashboard-head p:not(.eyebrow) {
      max-width: 62ch;
      margin-top: 1rem;
      color: var(--text-soft);
      font-size: 1.06rem;
      font-style: italic;
      line-height: 1.75;
    }

    .dashboard-stamp {
      display: grid;
      justify-items: end;
      gap: 0.25rem;
      border-top: 1px solid var(--accent-muted);
      padding-top: 1rem;
      color: var(--text-faint);
      font-family: var(--font-mono);
      text-align: right;
      text-transform: uppercase;
    }

    .dashboard-stamp span,
    .dashboard-stamp small {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
    }

    .dashboard-stamp strong {
      color: var(--accent);
      font-family: var(--font-serif);
      font-size: 3.4rem;
      line-height: 1;
    }

    .dashboard-controls {
      position: sticky;
      top: 5.4rem;
      z-index: 10;
      margin-bottom: 3.5rem;
      border: 1px solid var(--border);
      padding: 1rem;
      background: color-mix(in srgb, var(--bg-soft) 92%, transparent);
      backdrop-filter: blur(12px);
    }

    .view-switcher {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-bottom: 1rem;
    }

    .view-button,
    .dashboard-filters select {
      border: 1px solid var(--border);
      border-radius: 2px;
      background: var(--surface);
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .view-button {
      cursor: pointer;
      padding: 0.62rem 0.85rem;
      transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    }

    .view-button:hover,
    .view-button[aria-selected='true'] {
      border-color: var(--accent-muted);
      background: var(--surface-high);
      color: var(--text);
    }

    .dashboard-head-side {
      display: grid;
      justify-items: end;
      gap: 1.25rem;
    }

    .dashboard-head-side .dashboard-stamp {
      justify-self: stretch;
    }

    .density-switch {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: 2px;
    }

    .density-switch button {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      cursor: pointer;
      border: 0;
      padding: 0.62rem 0.75rem;
      background: var(--surface);
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      transition: color 0.2s ease, background 0.2s ease;
    }

    .density-switch button + button {
      border-left: 1px solid var(--border);
    }

    .density-switch button:hover,
    .density-switch button[aria-pressed='true'] {
      background: var(--surface-high);
      color: var(--text);
    }

    .dashboard-filters {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
      gap: 0.8rem;
    }

    .dashboard-status {
      display: grid;
      grid-template-rows: auto auto;
      align-content: end;
      justify-items: start;
      gap: 0.35rem;
      min-width: 7.5rem;
    }

    .dashboard-status p {
      margin: 0;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .dashboard-clear {
      cursor: pointer;
      border: 1px solid var(--accent-muted);
      border-radius: 2px;
      padding: 0.65rem 0.7rem;
      background: transparent;
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .dashboard-clear:hover {
      background: var(--surface-high);
    }

    .dashboard-clear[hidden] {
      display: none;
    }

    .dashboard-filters label {
      display: grid;
      gap: 0.35rem;
      min-width: 0;
    }

    .dashboard-filters span {
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .dashboard-filters select {
      width: 100%;
      min-width: 0;
      padding: 0.65rem 0.7rem;
    }

    @media (min-width: 821px) {
      .dashboard-controls {
        /* Sits right under the sticky site header (75.7 px tall at desktop widths). */
        top: 4.7rem;
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 0.75rem 1.5rem;
        padding: 0.6rem 0.75rem;
      }

      .view-switcher {
        margin-bottom: 0;
      }

      .dashboard-filters {
        flex: 1 1 32rem;
      }
    }

    .dashboard-group {
      margin-bottom: 4.8rem;
    }

    .dashboard-group:last-child {
      margin-bottom: 0;
    }

    .dashboard-group-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 1.5rem;
      border-top: 1px solid var(--border);
      margin-bottom: 1.6rem;
      padding-top: 1.25rem;
    }

    .dashboard-group-head a {
      color: var(--text);
    }

    .dashboard-group-head h3 {
      margin: 0;
      font-size: clamp(1.45rem, 3vw, 2.15rem);
      font-weight: 700;
      transition: color 0.2s ease;
    }

    .dashboard-group-head a:hover h3 {
      color: var(--accent);
    }

    .dashboard-group-head span {
      align-self: center;
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .dashboard-group-head p {
      grid-column: 1 / -1;
      max-width: 52rem;
      margin: 0.2rem 0 0;
      color: var(--text-soft);
      font-family: var(--font-serif);
      font-size: 1rem;
      font-style: italic;
      line-height: 1.5;
    }

    .dashboard-card {
      display: flex;
      min-width: 0;
    }

    /* List density (rows come from MovieRow; see global.css). These override the
       scoped grid rules above, so they live here with the same scoping. */
    [data-density='list'] .dashboard-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 0;
    }

    [data-density='list'] .dashboard-group {
      margin-bottom: 2.25rem;
    }

    [data-density='list'] .dashboard-group-head {
      margin-bottom: 0;
      padding-block: 0.9rem 0.6rem;
    }

    [data-density='list'] .dashboard-group-head h3 {
      font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    }

    [data-density='list'] .dashboard-group-head p {
      font-size: 0.9rem;
    }

    .dashboard-card[hidden],
    .dashboard-group[hidden],
    .dashboard-panel[hidden] {
      display: none;
    }

    .dashboard-empty {
      border: 1px solid var(--border);
      padding: 1.2rem;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    @media (max-width: 820px) {
      .dashboard-head {
        grid-template-columns: 1fr;
      }

      .dashboard-head-side {
        justify-items: start;
      }

      .dashboard-stamp {
        justify-items: start;
        text-align: left;
      }

      .archive-section {
        scroll-margin-top: 7.5rem;
      }

      .dashboard-controls {
        position: static;
      }

      .dashboard-filters {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .dashboard-status {
        grid-column: 1 / -1;
        grid-template-rows: none;
        grid-auto-flow: column;
        justify-content: space-between;
        align-items: center;
      }
    }

    @media (max-width: 560px) {
      .dashboard-filters {
        grid-template-columns: 1fr;
      }

      .dashboard-group-head {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view-button]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-dashboard-panel]'));
    const filters = {
      director: document.querySelector<HTMLSelectElement>('[data-dashboard-filter="director"]'),
      theme: document.querySelector<HTMLSelectElement>('[data-dashboard-filter="theme"]'),
      country: document.querySelector<HTMLSelectElement>('[data-dashboard-filter="country"]'),
    };
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-dashboard-sort]');
    const emptyState = document.querySelector<HTMLElement>('[data-dashboard-empty]');
    const countEl = document.querySelector<HTMLElement>('[data-dashboard-count]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-dashboard-clear]');
    const config = JSON.parse(document.getElementById('dashboard-config')?.textContent || '{}') as {
      countOne?: string;
      countOther?: string;
    };

    // Defaults are left out of the URL, so a plain `/` stays clean.
    const DEFAULT_VIEW = viewButtons[0]?.dataset.viewButton ?? 'directors';
    const DEFAULT_SORT = 'recency';
    const DEFAULT_DENSITY = 'grid';
    const DENSITY_KEY = 'shadowplay:archive-density';
    const archive = document.getElementById('archive');
    const densityButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-density-button]'));
    type FilterKey = keyof typeof filters;
    const filterKeys = Object.keys(filters) as FilterKey[];

    function activePanel() {
      return panels.find((panel) => !panel.hidden);
    }

    function hasOption(select: HTMLSelectElement, value: string) {
      return Array.from(select.options).some((option) => option.value === value);
    }

    function updateStatus(panel: HTMLElement) {
      // A film can sit in several groups (themes, connections): count each one once.
      const visible = new Set<string>();
      for (const card of Array.from(panel.querySelectorAll<HTMLElement>('.dashboard-card:not([hidden])'))) {
        const href = card.querySelector('a.card')?.getAttribute('href');
        if (href && !card.closest('[data-dashboard-group][hidden]')) visible.add(href);
      }
      if (countEl) {
        const template = visible.size === 1 ? config.countOne : config.countOther;
        countEl.textContent = (template ?? '{n}').replace('{n}', String(visible.size));
      }
      if (clearButton) clearButton.hidden = !filterKeys.some((key) => filters[key]?.value);
    }

    function writeUrlState() {
      const params = new URLSearchParams();
      const view = viewButtons.find((b) => b.getAttribute('aria-selected') === 'true')?.dataset.viewButton;
      if (view && view !== DEFAULT_VIEW) params.set('view', view);
      for (const key of filterKeys) {
        const value = filters[key]?.value;
        if (value) params.set(key, value);
      }
      if (sortSelect && sortSelect.value !== DEFAULT_SORT) params.set('sort', sortSelect.value);
      const density = archive?.dataset.density;
      if (density && density !== DEFAULT_DENSITY) params.set('density', density);
      const query = params.toString();
      // replaceState, not pushState: tweaking filters must not flood the Back button.
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    }

    function applyDashboard() {
      const panel = activePanel();
      if (!panel) return;

      const groups = Array.from(panel.querySelectorAll<HTMLElement>('[data-dashboard-group]'));
      const sort = sortSelect?.value ?? 'recency';
      groups
        .sort((a, b) => {
          if (sort === 'alpha') {
            return (a.dataset.sortAlpha ?? '').localeCompare(b.dataset.sortAlpha ?? '');
          }
          const key = sort === 'count' ? 'sortCount' : 'sortRecency';
          return Number(b.dataset[key] ?? 0) - Number(a.dataset[key] ?? 0);
        })
        .forEach((group) => panel.appendChild(group));

      let visibleGroups = 0;
      for (const group of groups) {
        let visibleCards = 0;
        const cards = Array.from(group.querySelectorAll<HTMLElement>('.dashboard-card'));
        for (const card of cards) {
          const tags = (card.dataset.tags ?? '').split('|');
          const visible =
            (!filters.director?.value || card.dataset.director === filters.director.value) &&
            (!filters.theme?.value || tags.includes(filters.theme.value)) &&
            (!filters.country?.value || card.dataset.country === filters.country.value);
          card.hidden = !visible;
          if (visible) visibleCards += 1;
        }
        group.hidden = visibleCards === 0;
        if (visibleCards > 0) visibleGroups += 1;
      }

      if (emptyState) emptyState.hidden = visibleGroups > 0;
      updateStatus(panel);
    }

    // Cards are "shot into" the archive as they scroll into view. Cards from views
    // rendered later (see hydratePanel) must be observed too, or they stay invisible.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) document.documentElement.classList.add('js-anim');
    const cardObserver = reduceMotion
      ? null
      : new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const card = entry.target as HTMLElement;
              const delay = Number(card.dataset.delay ?? 0);
              window.setTimeout(() => card.classList.add('is-hit'), delay);
              cardObserver?.unobserve(card);
            }
          },
          { threshold: 0.18 }
        );

    function observeCards(root: ParentNode) {
      if (!cardObserver) return;
      Array.from(root.querySelectorAll<HTMLElement>('.movie-grid .card')).forEach((card, i) => {
        card.dataset.delay = String((i % 3) * 90);
        cardObserver.observe(card);
      });
    }

    function hydratePanel(panel: HTMLElement) {
      const template = panel.querySelector<HTMLTemplateElement>(':scope > template[data-panel-template]');
      if (!template) return;
      panel.replaceChildren(template.content.cloneNode(true));
      observeCards(panel);
    }

    function selectView(button: HTMLButtonElement) {
      const nextView = button.dataset.viewButton;
      for (const candidate of viewButtons) {
        const selected = candidate === button;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      }
      for (const panel of panels) {
        const selected = panel.dataset.dashboardPanel === nextView;
        if (selected) hydratePanel(panel);
        panel.hidden = !selected;
      }
      applyDashboard();
    }

    function setDensity(density: string) {
      const next = densityButtons.some((b) => b.dataset.densityButton === density) ? density : DEFAULT_DENSITY;
      if (archive) archive.dataset.density = next;
      for (const button of densityButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.densityButton === next));
      }
    }

    function storedDensity(): string | null {
      try {
        return localStorage.getItem(DENSITY_KEY);
      } catch {
        return null;
      }
    }

    // Unknown values (a stale link, or a tag from the other language) are ignored silently.
    function readUrlState() {
      const params = new URLSearchParams(location.search);
      // The URL wins; without it, the reader's last choice on this browser.
      setDensity(params.get('density') ?? storedDensity() ?? DEFAULT_DENSITY);
      for (const key of filterKeys) {
        const select = filters[key];
        if (!select) continue;
        const value = params.get(key) ?? '';
        select.value = hasOption(select, value) ? value : '';
      }
      if (sortSelect) {
        const sort = params.get('sort') ?? DEFAULT_SORT;
        sortSelect.value = hasOption(sortSelect, sort) ? sort : DEFAULT_SORT;
      }
      const view = params.get('view') ?? DEFAULT_VIEW;
      const button = viewButtons.find((b) => b.dataset.viewButton === view) ?? viewButtons[0];
      if (button) selectView(button);
    }

    for (const button of viewButtons) {
      button.addEventListener('click', () => {
        selectView(button);
        writeUrlState();
      });
    }

    // Arrow keys move between tabs (and select them), as the tablist role promises.
    document.querySelector('.view-switcher')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const index = viewButtons.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      const last = viewButtons.length - 1;
      const next =
        key === 'ArrowRight' ? (index === last ? 0 : index + 1)
        : key === 'ArrowLeft' ? (index === 0 ? last : index - 1)
        : key === 'Home' ? 0
        : key === 'End' ? last
        : -1;
      if (next === -1) return;
      event.preventDefault();
      viewButtons[next].focus();
      selectView(viewButtons[next]);
      writeUrlState();
    });

    for (const button of densityButtons) {
      button.addEventListener('click', () => {
        const density = button.dataset.densityButton ?? DEFAULT_DENSITY;
        setDensity(density);
        try {
          localStorage.setItem(DENSITY_KEY, density);
        } catch {
          // Storage blocked (private mode): the URL still carries the choice.
        }
        writeUrlState();
      });
    }

    const onControlChange = () => {
      applyDashboard();
      writeUrlState();
    };
    Object.values(filters).forEach((filter) => filter?.addEventListener('change', onControlChange));
    sortSelect?.addEventListener('change', onControlChange);

    clearButton?.addEventListener('click', () => {
      for (const key of filterKeys) {
        const select = filters[key];
        if (select) select.value = '';
      }
      onControlChange();
      // The button hides itself; keep keyboard focus inside the controls.
      filters.director?.focus();
    });

    observeCards(document);
    readUrlState();

    // Back from a film page restores the query; bfcache restores need a re-read too.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) readUrlState();
    });
  </script>
</BaseLayout>
