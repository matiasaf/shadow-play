---
import Frame from './Frame.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { slugOf, type MovieEntry } from '../lib/movies';
import { localizePath } from '../i18n/ui';
import { caseNo, runtimeTimecode } from '../lib/format';

interface Props {
  movie: MovieEntry;
  index?: number;
  lang: Lang;
}

const { movie, index = 1, lang } = Astro.props;
const { data } = movie;
const t = useTranslations(lang);
const href = localizePath(`/films/${slugOf(movie)}/`, lang);
const meta = [data.director, String(data.year), data.country].filter(Boolean).join(' · ');
---

<a class="card" href={href}>
  <div class="sprockets" aria-hidden="true"></div>
  <div class="card-frame is-frame">
    <Frame
      src={data.frame}
      alt={`${t('film.frameAlt')} ${data.title}`}
      title={data.title}
      code={runtimeTimecode(data.runtime)}
      noFrameLabel={t('frame.noFrame')}
      width={520}
      height={293}
    />
  </div>
  <div class="card-body">
    <div class="card-kicker">
      <span>{caseNo(index)}</span>
      <span>{runtimeTimecode(data.runtime)} · {data.year}</span>
    </div>
    <h2 class="card-title">{data.title}</h2>
    <p class="card-meta">{meta}</p>
    <p class="card-logline">{data.logline}</p>
    {
      data.tags.length > 0 && (
        <div class="tag-row">
          {data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
