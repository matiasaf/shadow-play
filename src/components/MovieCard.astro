---
import { Image } from 'astro:assets';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { slugOf, type MovieEntry } from '../lib/movies';

interface Props {
  movie: MovieEntry;
  index?: number;
  lang: Lang;
}

const { movie, index = 1, lang } = Astro.props;
const { data } = movie;
const t = useTranslations(lang);
const archiveNumber = String(index).padStart(3, '0');
const category = data.tags[0] ?? t('card.category.fallback');
const href = localizePath(`/films/${slugOf(movie)}/`, lang);
---

<a class="card" href={href}>
  <div class="card-frame">
    {
      data.frame ? (
        <Image src={data.frame} alt={`${t('film.frameAlt')} ${data.title}`} width={480} height={270} />
      ) : (
        <span class="placeholder">
          <span>{data.title.charAt(0)}</span>
          <small>{t('card.framePending')}</small>
        </span>
      )
    }
  </div>
  <div class="card-body">
    <div class="card-kicker">
      <span>{category}</span>
      <span>#{archiveNumber}</span>
    </div>
    <h2 class="card-title">{data.title}</h2>
    <p class="card-meta">{data.director} · {data.year}</p>
    <p class="card-logline">{data.logline}</p>
    {
      data.tags.length > 0 && (
        <div class="tag-row">
          {data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
