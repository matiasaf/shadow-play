---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A single film "frame": a real still when available, otherwise a generative
// noir placeholder. Always laid over with film grain, venetian-blind shadow
// and a projector vignette. Drop it inside a container with `class="is-frame"`.
interface Props {
  src?: ImageMetadata;
  alt: string;
  title: string;
  /** small mono caption shown on the generative placeholder, e.g. a timecode */
  code?: string;
  noFrameLabel?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  title,
  code,
  noFrameLabel = 'No frame',
  width = 640,
  height = 360,
  loading = 'lazy',
} = Astro.props;
---

{
  src ? (
    <Image src={src} alt={alt} width={width} height={height} loading={loading} class="frame-img" />
  ) : (
    <div class="frame-gen" role="img" aria-label={alt}>
      <span class="frame-gen-initial">{title.charAt(0)}</span>
      <span class="frame-gen-code">{noFrameLabel}{code ? ` · ${code}` : ''}</span>
    </div>
  )
}
<span class="frame-blinds" aria-hidden="true"></span>
<span class="frame-grain" aria-hidden="true"></span>
<span class="frame-vignette" aria-hidden="true"></span>
