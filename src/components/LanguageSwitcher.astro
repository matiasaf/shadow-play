---
import { languages, getLangFromUrl, stripLangFromPath, localizePath, type Lang } from '../i18n/ui';

const current = getLangFromUrl(Astro.url);
const neutralPath = stripLangFromPath(Astro.url.pathname);
const order: Lang[] = ['en', 'es'];
---

<div class="lang-switch" role="group" aria-label="Language">
  {
    order.map((lang) => (
      <a
        href={localizePath(neutralPath, lang)}
        class:list={['lang-opt', { active: lang === current }]}
        aria-current={lang === current ? 'true' : undefined}
        hreflang={lang}
        lang={lang}
      >
        {lang.toUpperCase()}
        <span class="sr-only">{languages[lang]}</span>
      </a>
    ))
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.18rem;
    font-family: var(--font-mono, var(--font-sans));
  }

  .lang-opt {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: var(--text-faint);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .lang-opt:hover {
    color: var(--accent);
  }

  .lang-opt.active {
    background: var(--accent-soft);
    color: var(--text);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
