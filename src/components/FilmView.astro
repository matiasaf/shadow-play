---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from './Frame.astro';
import { useTranslations, localizePath, dateLocale, type Lang } from '../i18n/ui';
import { slugOf, type MovieEntry } from '../lib/movies';
import { caseNo, runtimeTimecode } from '../lib/format';

interface Props {
  lang: Lang;
  movie: MovieEntry;
  all: MovieEntry[];
}

const { lang, movie, all } = Astro.props;
const { data } = movie;
const t = useTranslations(lang);
const { Content } = await render(movie);

// Connections reference language-neutral slugs; resolve within this language.
const titleBySlug = new Map(all.map((m) => [slugOf(m), m.data.title]));
const movieBySlug = new Map(all.map((m) => [slugOf(m), m]));

// Archive case number = chronological position (newest = highest).
const idx = all.findIndex((m) => m.id === movie.id);
const caseNumber = caseNo(idx === -1 ? all.length : all.length - idx);
const timecode = runtimeTimecode(data.runtime);

const watched = data.watchedOn.toLocaleDateString(dateLocale[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const metaParts = [
  data.director,
  String(data.year),
  data.country,
  data.runtime ? `${data.runtime} min` : null,
].filter(Boolean);
---

<BaseLayout title={`${data.title} — ${t('brand')}`} description={data.logline} lang={lang}>
  <article class="film-page">
    <div class="wrap film-backbar">
      <a href={localizePath('/', lang)} class="back-link"
        ><span aria-hidden="true">←</span> {t('film.back')}</a
      >
    </div>

    <header class="wrap film-hero selected-film-hero">
      <div class="film-heading">
        <div class="film-overline" aria-hidden="true">
          <span>{caseNumber}</span>
          <span class="film-overline-sep"></span>
          <span>{t('film.studyFile')}</span>
          <span class="film-overline-sep"></span>
          <span>{timecode}</span>
        </div>
        <h1>{data.title}</h1>
        {data.originalTitle && <p class="original">{data.originalTitle}</p>}

        <div class="film-meta">
          {
            metaParts.map((part, i) => (
              <>
                {i > 0 && <span class="sep"></span>}
                <span>{part}</span>
              </>
            ))
          }
          <span class="sep"></span>
          <span class="watched">{t('film.watched')} {watched}</span>
        </div>

        {
          data.rating && (
            <div class="film-rating" title={`${data.rating} ${t('film.ratingOf')}`}>
              {'★'.repeat(data.rating)}
              <span>{'★'.repeat(5 - data.rating)}</span>
            </div>
          )
        }

        <blockquote class="film-logline">"{data.logline}"</blockquote>
      </div>
    </header>

    <figure class="wrap frame-figure selected-frame">
      <div class="frame-stage is-frame">
        <Frame
          src={data.frame}
          alt={`${t('film.frameAlt')} ${data.title}`}
          title={data.title}
          code={timecode}
          noFrameLabel={t('frame.noFrame')}
          width={1100}
          height={619}
          loading="eager"
        />
      </div>
      <figcaption>
        {data.frameCaption || `Fig. 1: ${t('film.framePendingCaption')} ${data.title}.`}
      </figcaption>
    </figure>

    <div class="wrap">
      <div class="prose film-prose">
        <Content />
      </div>

      {
        data.connections.length > 0 && (
          <section class="connections selected-connections">
            <h2>{t('film.connections')}</h2>
            <div class="connection-grid">
              {data.connections.map((c) => {
                const title = titleBySlug.get(c.slug);
                const related = movieBySlug.get(c.slug);
                return title ? (
                  <a class="connection" href={localizePath(`/films/${c.slug}/`, lang)}>
                    <div class="connection-frame is-frame">
                      <Frame
                        src={related?.data.frame}
                        alt={`${t('film.frameAlt')} ${related?.data.title ?? title}`}
                        title={title}
                        code={runtimeTimecode(related?.data.runtime)}
                        noFrameLabel={t('frame.noFrame')}
                        width={420}
                        height={236}
                      />
                    </div>
                    <div class="to">{title}</div>
                    <div class="why">{c.note}</div>
                  </a>
                ) : (
                  <div class="connection">
                    <div class="connection-frame is-frame">
                      <Frame src={undefined} alt={c.slug} title={c.slug} noFrameLabel={t('frame.noFrame')} />
                    </div>
                    <div class="to">{c.slug}</div>
                    <div class="why">{c.note}</div>
                  </div>
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .film-page {
    padding-block: 3rem 4rem;
  }

  .film-backbar {
    margin-bottom: 3rem;
  }

  .film-backbar .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .film-backbar .back-link:hover {
    color: var(--accent);
  }

  .selected-film-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(220px, 4fr);
    gap: 2rem;
    padding-block: 0 4rem;
  }

  .film-heading {
    grid-column: 1 / 2;
  }

  .film-overline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.3rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .film-overline-sep {
    width: 0.9rem;
    height: 1px;
    background: var(--border);
  }

  .selected-film-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(3rem, 8vw, 5.6rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .selected-film-hero .original {
    margin-bottom: 1.2rem;
    color: var(--text-faint);
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  .selected-film-hero .film-meta {
    margin-top: 0;
    margin-bottom: 1.35rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .selected-film-hero .film-meta .sep {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--border);
  }

  .selected-film-hero .watched {
    color: var(--accent-strong);
  }

  .film-rating {
    margin-bottom: 2rem;
    color: var(--accent);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .film-rating span {
    color: var(--border);
  }

  .selected-film-hero .film-logline {
    max-width: 40rem;
    margin: 0;
    border-left: 2px solid var(--accent-strong);
    padding-left: 1.6rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-style: italic;
    line-height: 1.45;
  }

  .selected-frame {
    margin-block: 0 4rem;
  }

  .frame-stage {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
  }

  .selected-frame figcaption {
    max-width: 70ch;
    margin-top: 1.4rem;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-style: italic;
    text-align: left;
  }

  .film-prose {
    max-width: 65ch;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .film-prose h2 {
    margin-bottom: 1.4rem;
    font-size: 2rem;
  }

  .film-prose p,
  .film-prose li {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .film-prose blockquote {
    margin-block: 3rem;
    border-block: 1px solid var(--border);
    border-left: 0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .selected-connections {
    max-width: none;
    margin-top: 5rem;
    padding-top: 3.5rem;
  }

  .selected-connections h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .connection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .selected-connections .connection {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .connection-frame {
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    background: var(--surface-high);
  }

  .connection-frame :global(.frame-img) {
    opacity: 0.72;
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }

  .connection:hover .connection-frame :global(.frame-img) {
    opacity: 1;
    transform: scale(1.04);
  }

  .selected-connections .to {
    color: var(--text);
    font-size: 1.35rem;
    transition: color 0.2s ease;
  }

  .selected-connections .connection:hover .to {
    color: var(--accent);
  }

  .selected-connections .why {
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .film-page {
      padding-block-start: 2rem;
    }

    .film-backbar {
      margin-bottom: 2rem;
    }

    .selected-film-hero {
      display: block;
      padding-bottom: 3rem;
    }

    .selected-film-hero .film-meta {
      gap: 0.55rem;
    }

    .selected-film-hero .film-logline {
      padding-left: 1rem;
    }
  }
</style>
