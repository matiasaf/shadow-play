---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from './Frame.astro';
import { useTranslations, localizePath, dateLocale, type Lang } from '../i18n/ui';
import { slugOf, type MovieEntry } from '../lib/movies';
import { directorSlug } from '../lib/directors';
import { caseNo, runtimeTimecode } from '../lib/format';

interface Props {
  lang: Lang;
  movie: MovieEntry;
  all: MovieEntry[];
}

const { lang, movie, all } = Astro.props;
const { data } = movie;
const t = useTranslations(lang);
const { Content } = await render(movie);

// Connections reference language-neutral slugs; resolve within this language.
const titleBySlug = new Map(all.map((m) => [slugOf(m), m.data.title]));
const movieBySlug = new Map(all.map((m) => [slugOf(m), m]));

// Archive case number = chronological position (newest = highest).
const idx = all.findIndex((m) => m.id === movie.id);
const caseNumber = caseNo(idx === -1 ? all.length : all.length - idx);
const timecode = runtimeTimecode(data.runtime);

const watched = data.watchedOn.toLocaleDateString(dateLocale[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const directorHref = localizePath(`/directors/${directorSlug(data.director)}/`, lang);
const metaParts = [
  String(data.year),
  data.country,
  data.runtime ? `${data.runtime} min` : null,
].filter(Boolean);

function youtubeIdFromUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === 'youtu.be') return parsed.pathname.slice(1) || null;
    if (parsed.hostname.endsWith('youtube.com')) {
      if (parsed.pathname.startsWith('/embed/')) return parsed.pathname.split('/')[2] || null;
      if (parsed.pathname.startsWith('/shorts/')) return parsed.pathname.split('/')[2] || null;
      return parsed.searchParams.get('v');
    }
  } catch {
    return null;
  }

  return null;
}

function youtubeThumbnail(url: string): string | null {
  const id = youtubeIdFromUrl(url);
  return id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null;
}

function youtubeEmbedUrl(url: string): string | null {
  const id = youtubeIdFromUrl(url);
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
}
---

<BaseLayout title={`${data.title} — ${t('brand')}`} description={data.logline} lang={lang}>
  <article class="film-page">
    <div class="wrap film-backbar">
      <a href={localizePath('/', lang)} class="back-link"
        ><span aria-hidden="true">←</span> {t('film.back')}</a
      >
    </div>

    <header class="wrap film-hero selected-film-hero">
      <div class="film-heading">
        <div class="film-overline" aria-hidden="true">
          <span>{caseNumber}</span>
          <span class="film-overline-sep"></span>
          <span>{t('film.studyFile')}</span>
          <span class="film-overline-sep"></span>
          <span>{timecode}</span>
        </div>
        <h1>{data.title}</h1>
        {data.originalTitle && <p class="original">{data.originalTitle}</p>}

        <div class="film-meta">
          <a class="director-link" href={directorHref}>{data.director}</a>
          {
            metaParts.map((part) => (
              <>
                <span class="sep"></span>
                <span>{part}</span>
              </>
            ))
          }
          <span class="sep"></span>
          <span class="watched">{t('film.watched')} {watched}</span>
        </div>

        {
          data.rating && (
            <div class="film-rating" title={`${data.rating} ${t('film.ratingOf')}`}>
              {'★'.repeat(data.rating)}
              <span>{'★'.repeat(5 - data.rating)}</span>
            </div>
          )
        }

        <blockquote class="film-logline">"{data.logline}"</blockquote>
      </div>
    </header>

    <figure class="wrap frame-figure selected-frame">
      <div class="frame-stage is-frame">
        <Frame
          src={data.frame}
          alt={`${t('film.frameAlt')} ${data.title}`}
          title={data.title}
          code={timecode}
          noFrameLabel={t('frame.noFrame')}
          width={1100}
          height={619}
          loading="eager"
        />
      </div>
      <figcaption>
        {data.frameCaption || `Fig. 1: ${t('film.framePendingCaption')} ${data.title}.`}
      </figcaption>
    </figure>

    <div class="wrap">
      <div class="prose film-prose">
        <Content />
      </div>

      {
        data.externalComments.length > 0 && (
          <section class="external-section selected-external-comments">
            <h2>{t('film.externalComments')}</h2>
            <div class="external-grid comments-grid">
              {data.externalComments.map((comment) => (
                <a class="external-card comment-card" href={comment.url} target="_blank" rel="noreferrer">
                  <div class="external-card-kicker">
                    <span>{comment.source}</span>
                    {comment.author && <span>{comment.author}</span>}
                  </div>
                  {comment.title && <h3>{comment.title}</h3>}
                  <blockquote>{comment.quote}</blockquote>
                  {comment.note && <p class="external-note">{comment.note}</p>}
                  <span class="external-link">{t('film.openExternal')}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        data.videos.length > 0 && (
          <section class="external-section selected-videos">
            <h2>{t('film.videos')}</h2>
            <div class="external-grid video-grid">
              {data.videos.map((video) => {
                const thumbnail = youtubeThumbnail(video.url);
                const embedUrl = video.embed ? youtubeEmbedUrl(video.url) : null;
                return (
                  <article class="external-card video-card">
                    {embedUrl ? (
                      <iframe
                        src={embedUrl}
                        title={video.title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                      />
                    ) : (
                      <a class="video-thumb" href={video.url} target="_blank" rel="noreferrer">
                        {thumbnail ? <img src={thumbnail} alt="" loading="lazy" /> : <span>{t('film.videoFallback')}</span>}
                      </a>
                    )}
                    <div class="video-copy">
                      <div class="external-card-kicker">
                        <span>{video.platform}</span>
                        {video.channel && <span>{video.channel}</span>}
                      </div>
                      <h3>
                        <a href={video.url} target="_blank" rel="noreferrer">{video.title}</a>
                      </h3>
                      {video.note && <p class="external-note">{video.note}</p>}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      {
        data.connections.length > 0 && (
          <section class="connections selected-connections">
            <h2>{t('film.connections')}</h2>
            <div class="connection-grid">
              {data.connections.map((c) => {
                const title = titleBySlug.get(c.slug);
                const related = movieBySlug.get(c.slug);
                return title ? (
                  <a class="connection" href={localizePath(`/films/${c.slug}/`, lang)}>
                    <div class="connection-frame is-frame">
                      <Frame
                        src={related?.data.frame}
                        alt={`${t('film.frameAlt')} ${related?.data.title ?? title}`}
                        title={title}
                        code={runtimeTimecode(related?.data.runtime)}
                        noFrameLabel={t('frame.noFrame')}
                        width={420}
                        height={236}
                      />
                    </div>
                    <div class="to">{title}</div>
                    <div class="why">{c.note}</div>
                  </a>
                ) : (
                  <div class="connection">
                    <div class="connection-frame is-frame">
                      <Frame src={undefined} alt={c.slug} title={c.slug} noFrameLabel={t('frame.noFrame')} />
                    </div>
                    <div class="to">{c.slug}</div>
                    <div class="why">{c.note}</div>
                  </div>
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .film-page {
    padding-block: 3rem 4rem;
  }

  .film-backbar {
    margin-bottom: 3rem;
  }

  .film-backbar .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .film-backbar .back-link:hover {
    color: var(--accent);
  }

  .selected-film-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(220px, 4fr);
    gap: 2rem;
    padding-block: 0 4rem;
  }

  .film-heading {
    grid-column: 1 / 2;
  }

  .film-overline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.3rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .film-overline-sep {
    width: 0.9rem;
    height: 1px;
    background: var(--border);
  }

  .selected-film-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(3rem, 8vw, 5.6rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .selected-film-hero .original {
    margin-bottom: 1.2rem;
    color: var(--text-faint);
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  .selected-film-hero .film-meta {
    margin-top: 0;
    margin-bottom: 1.35rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .selected-film-hero .film-meta .sep {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--border);
  }

  .selected-film-hero .watched {
    color: var(--accent-strong);
  }

  .selected-film-hero .director-link {
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.3em;
    transition: color 0.2s ease;
  }

  .selected-film-hero .director-link:hover {
    color: var(--accent);
  }

  .film-rating {
    margin-bottom: 2rem;
    color: var(--accent);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .film-rating span {
    color: var(--border);
  }

  .selected-film-hero .film-logline {
    max-width: 40rem;
    margin: 0;
    border-left: 2px solid var(--accent-strong);
    padding-left: 1.6rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-style: italic;
    line-height: 1.45;
  }

  .selected-frame {
    margin-block: 0 4rem;
  }

  .frame-stage {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
  }

  .selected-frame figcaption {
    max-width: 70ch;
    margin-top: 1.4rem;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-style: italic;
    text-align: left;
  }

  .film-prose {
    max-width: 65ch;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .film-prose h2 {
    margin-bottom: 1.4rem;
    font-size: 2rem;
  }

  .film-prose p,
  .film-prose li {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .film-prose blockquote {
    margin-block: 3rem;
    border-block: 1px solid var(--border);
    border-left: 0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .external-section {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--border);
  }

  .external-section h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .external-grid {
    display: grid;
    gap: 1.5rem;
  }

  .comments-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .video-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .external-card {
    display: block;
    border: 1px solid var(--border);
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .comment-card {
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .comment-card:hover {
    border-color: var(--accent-strong);
    background: rgba(255, 255, 255, 0.035);
    transform: translateY(-2px);
  }

  .external-card-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .external-card-kicker span + span::before {
    content: '/';
    margin-right: 0.55rem;
    color: var(--border);
  }

  .external-card h3 {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .external-card h3 a {
    color: inherit;
  }

  .external-card h3 a:hover {
    color: var(--accent);
  }

  .comment-card blockquote {
    margin: 0;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.06rem;
    font-style: italic;
    line-height: 1.6;
  }

  .external-note {
    margin: 1rem 0 0;
    color: var(--text-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .external-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .video-card {
    padding: 0;
    overflow: hidden;
  }

  .video-thumb,
  .video-card iframe {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    border: 0;
    background: var(--surface-high);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .video-thumb:hover img {
    filter: grayscale(0) contrast(1.08);
    transform: scale(1.03);
  }

  .video-copy {
    padding: 1.25rem;
  }

  .selected-connections {
    max-width: none;
    margin-top: 5rem;
    padding-top: 3.5rem;
  }

  .selected-connections h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .connection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .selected-connections .connection {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .connection-frame {
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    background: var(--surface-high);
  }

  .connection-frame :global(.frame-img) {
    opacity: 0.72;
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }

  .connection:hover .connection-frame :global(.frame-img) {
    opacity: 1;
    transform: scale(1.04);
  }

  .selected-connections .to {
    color: var(--text);
    font-size: 1.35rem;
    transition: color 0.2s ease;
  }

  .selected-connections .connection:hover .to {
    color: var(--accent);
  }

  .selected-connections .why {
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .film-page {
      padding-block-start: 2rem;
    }

    .film-backbar {
      margin-bottom: 2rem;
    }

    .selected-film-hero {
      display: block;
      padding-bottom: 3rem;
    }

    .selected-film-hero .film-meta {
      gap: 0.55rem;
    }

    .selected-film-hero .film-logline {
      padding-left: 1rem;
    }
  }
</style>
