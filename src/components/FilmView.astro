---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from './Frame.astro';
import { useTranslations, localizePath, dateLocale, type Lang } from '../i18n/ui';
import { slugOf, type MovieEntry } from '../lib/movies';
import { directorSlug } from '../lib/directors';
import { caseNo, runtimeTimecode } from '../lib/format';

interface Props {
  lang: Lang;
  movie: MovieEntry;
  all: MovieEntry[];
}

const { lang, movie, all } = Astro.props;
const { data } = movie;
const t = useTranslations(lang);
const { Content } = await render(movie);

// Connections reference language-neutral slugs; resolve within this language.
const titleBySlug = new Map(all.map((m) => [slugOf(m), m.data.title]));
const movieBySlug = new Map(all.map((m) => [slugOf(m), m]));

// Archive case number = chronological position (newest = highest).
const idx = all.findIndex((m) => m.id === movie.id);
const caseNumber = caseNo(idx === -1 ? all.length : all.length - idx);
const timecode = runtimeTimecode(data.runtime);

const watched = data.watchedOn.toLocaleDateString(dateLocale[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const directorHref = localizePath(`/directors/${directorSlug(data.director)}/`, lang);
const metaParts = [
  String(data.year),
  data.country,
  data.runtime ? `${data.runtime} min` : null,
].filter(Boolean);

const externalComments = data.externalComments.map((comment, index) => ({
  ...comment,
  id: `external-comment-${slugOf(movie)}-${index}`,
  summary: comment.summary ?? comment.quote ?? comment.body ?? '',
  body: comment.body ?? comment.quote ?? comment.summary ?? '',
}));

function youtubeIdFromUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === 'youtu.be') return parsed.pathname.slice(1) || null;
    if (parsed.hostname.endsWith('youtube.com')) {
      if (parsed.pathname.startsWith('/embed/')) return parsed.pathname.split('/')[2] || null;
      if (parsed.pathname.startsWith('/shorts/')) return parsed.pathname.split('/')[2] || null;
      return parsed.searchParams.get('v');
    }
  } catch {
    return null;
  }

  return null;
}

function youtubeThumbnail(url: string): string | null {
  const id = youtubeIdFromUrl(url);
  return id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null;
}

function youtubeEmbedUrl(url: string): string | null {
  const id = youtubeIdFromUrl(url);
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
}
---

<BaseLayout title={`${data.title} — ${t('brand')}`} description={data.logline} lang={lang}>
  <article class="film-page">
    <div class="wrap film-backbar">
      <a href={localizePath('/', lang)} class="back-link"
        ><span aria-hidden="true">←</span> {t('film.back')}</a
      >
    </div>

    <header class="wrap film-hero selected-film-hero">
      <div class="film-heading">
        <div class="film-overline" aria-hidden="true">
          <span>{caseNumber}</span>
          <span class="film-overline-sep"></span>
          <span>{t('film.studyFile')}</span>
          <span class="film-overline-sep"></span>
          <span>{timecode}</span>
        </div>
        <h1>{data.title}</h1>
        {data.originalTitle && <p class="original">{data.originalTitle}</p>}

        <div class="film-meta">
          <a class="director-link" href={directorHref}>{data.director}</a>
          {
            metaParts.map((part) => (
              <>
                <span class="sep"></span>
                <span>{part}</span>
              </>
            ))
          }
          <span class="sep"></span>
          <span class="watched">{t('film.watched')} {watched}</span>
        </div>

        {
          data.rating && (
            <div class="film-rating" title={`${data.rating} ${t('film.ratingOf')}`}>
              {'★'.repeat(data.rating)}
              <span>{'★'.repeat(5 - data.rating)}</span>
            </div>
          )
        }

        <blockquote class="film-logline">"{data.logline}"</blockquote>
      </div>
    </header>

    <figure class="wrap frame-figure selected-frame">
      <div class="frame-stage is-frame">
        <Frame
          src={data.frame}
          alt={`${t('film.frameAlt')} ${data.title}`}
          title={data.title}
          code={timecode}
          noFrameLabel={t('frame.noFrame')}
          width={1100}
          height={619}
          loading="eager"
        />
      </div>
      <figcaption>
        {data.frameCaption || `Fig. 1: ${t('film.framePendingCaption')} ${data.title}.`}
      </figcaption>
    </figure>

    <div class="wrap">
      <div class="prose film-prose">
        <Content />
      </div>

      {
        externalComments.length > 0 && (
          <section class="external-section selected-external-comments">
            <h2>{t('film.externalComments')}</h2>
            <div class="external-grid comments-grid">
              {externalComments.map((comment) => (
                <article class="external-card comment-card">
                  <button class="comment-card-button" type="button" data-comment-open={comment.id}>
                    <div class="external-card-kicker">
                      <span>{comment.source}</span>
                      {comment.author && <span>{comment.author}</span>}
                    </div>
                    {comment.title && <h3>{comment.title}</h3>}
                    <p class="comment-summary">{comment.summary}</p>
                    {comment.note && <p class="external-note">{comment.note}</p>}
                    <span class="external-link">{t('film.readComment')}</span>
                  </button>
                  <a class="comment-original-link" href={comment.url} target="_blank" rel="noreferrer">
                    {t('film.openExternal')}
                  </a>
                  <dialog class="comment-modal" id={comment.id} aria-labelledby={`${comment.id}-title`}>
                    <div class="comment-modal-panel">
                      <div class="comment-modal-head">
                        <div>
                          <div class="external-card-kicker">
                            <span>{comment.source}</span>
                            {comment.author && <span>{comment.author}</span>}
                          </div>
                          <h3 id={`${comment.id}-title`}>{comment.title ?? t('film.externalComment')}</h3>
                        </div>
                        <button class="comment-modal-close" type="button" data-comment-close aria-label={t('film.closeModal')}>
                          ×
                        </button>
                      </div>
                      <div class="comment-modal-body">
                        {comment.body.split('\n').map((paragraph) =>
                          paragraph.trim() ? <p>{paragraph}</p> : null
                        )}
                      </div>
                      <div class="comment-modal-actions">
                        <a href={comment.url} target="_blank" rel="noreferrer">{t('film.openExternal')}</a>
                        <button type="button" data-comment-close>{t('film.closeModal')}</button>
                      </div>
                    </div>
                  </dialog>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        data.videos.length > 0 && (
          <section class="external-section selected-videos">
            <h2>{t('film.videos')}</h2>
            <div class="external-grid video-grid">
              {data.videos.map((video) => {
                const thumbnail = youtubeThumbnail(video.url);
                const embedUrl = video.embed ? youtubeEmbedUrl(video.url) : null;
                return (
                  <article class="external-card video-card">
                    {embedUrl ? (
                      <iframe
                        src={embedUrl}
                        title={video.title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                      />
                    ) : (
                      <a class="video-thumb" href={video.url} target="_blank" rel="noreferrer">
                        {thumbnail ? <img src={thumbnail} alt="" loading="lazy" /> : <span>{t('film.videoFallback')}</span>}
                      </a>
                    )}
                    <div class="video-copy">
                      <div class="external-card-kicker">
                        <span>{video.platform}</span>
                        {video.channel && <span>{video.channel}</span>}
                      </div>
                      <h3>
                        <a href={video.url} target="_blank" rel="noreferrer">{video.title}</a>
                      </h3>
                      {video.note && <p class="external-note">{video.note}</p>}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      {
        data.connections.length > 0 && (
          <section class="connections selected-connections">
            <h2>{t('film.connections')}</h2>
            <div class="connection-grid">
              {data.connections.map((c) => {
                const title = titleBySlug.get(c.slug);
                const related = movieBySlug.get(c.slug);
                return title ? (
                  <a class="connection" href={localizePath(`/films/${c.slug}/`, lang)}>
                    <div class="connection-frame is-frame">
                      <Frame
                        src={related?.data.frame}
                        alt={`${t('film.frameAlt')} ${related?.data.title ?? title}`}
                        title={title}
                        code={runtimeTimecode(related?.data.runtime)}
                        noFrameLabel={t('frame.noFrame')}
                        width={420}
                        height={236}
                      />
                    </div>
                    <div class="to">{title}</div>
                    <div class="why">{c.note}</div>
                  </a>
                ) : (
                  <div class="connection">
                    <div class="connection-frame is-frame">
                      <Frame src={undefined} alt={c.slug} title={c.slug} noFrameLabel={t('frame.noFrame')} />
                    </div>
                    <div class="to">{c.slug}</div>
                    <div class="why">{c.note}</div>
                  </div>
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-comment-open]');
  const closeButtons = document.querySelectorAll<HTMLButtonElement>('[data-comment-close]');

  openButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const modalId = button.dataset.commentOpen;
      const modal = modalId ? document.getElementById(modalId) : null;
      if (modal instanceof HTMLDialogElement) modal.showModal();
    });
  });

  closeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const modal = button.closest('dialog');
      if (modal instanceof HTMLDialogElement) modal.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('.comment-modal').forEach((modal) => {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
  });
</script>

<style>
  .film-page {
    padding-block: 3rem 4rem;
  }

  .film-backbar {
    margin-bottom: 3rem;
  }

  .film-backbar .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .film-backbar .back-link:hover {
    color: var(--accent);
  }

  .selected-film-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(220px, 4fr);
    gap: 2rem;
    padding-block: 0 4rem;
  }

  .film-heading {
    grid-column: 1 / 2;
  }

  .film-overline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.3rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .film-overline-sep {
    width: 0.9rem;
    height: 1px;
    background: var(--border);
  }

  .selected-film-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(3rem, 8vw, 5.6rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .selected-film-hero .original {
    margin-bottom: 1.2rem;
    color: var(--text-faint);
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  .selected-film-hero .film-meta {
    margin-top: 0;
    margin-bottom: 1.35rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .selected-film-hero .film-meta .sep {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--border);
  }

  .selected-film-hero .watched {
    color: var(--accent-strong);
  }

  .selected-film-hero .director-link {
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.3em;
    transition: color 0.2s ease;
  }

  .selected-film-hero .director-link:hover {
    color: var(--accent);
  }

  .film-rating {
    margin-bottom: 2rem;
    color: var(--accent);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .film-rating span {
    color: var(--border);
  }

  .selected-film-hero .film-logline {
    max-width: 40rem;
    margin: 0;
    border-left: 2px solid var(--accent-strong);
    padding-left: 1.6rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-style: italic;
    line-height: 1.45;
  }

  .selected-frame {
    margin-block: 0 4rem;
  }

  .frame-stage {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
  }

  .selected-frame figcaption {
    max-width: 70ch;
    margin-top: 1.4rem;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-style: italic;
    text-align: left;
  }

  .film-prose {
    max-width: 65ch;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .film-prose h2 {
    margin-bottom: 1.4rem;
    font-size: 2rem;
  }

  .film-prose p,
  .film-prose li {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .film-prose blockquote {
    margin-block: 3rem;
    border-block: 1px solid var(--border);
    border-left: 0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .external-section {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--border);
  }

  .external-section h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .external-grid {
    display: grid;
    gap: 1.5rem;
  }

  .comments-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .video-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .external-card {
    display: block;
    border: 1px solid var(--border);
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .comment-card {
    padding: 0;
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .comment-card:hover {
    border-color: var(--accent-strong);
    background: rgba(255, 255, 255, 0.035);
    transform: translateY(-2px);
  }

  .comment-card-button {
    display: block;
    width: 100%;
    border: 0;
    padding: 1.25rem 1.25rem 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .comment-card-button:focus-visible,
  .comment-original-link:focus-visible,
  .comment-modal-close:focus-visible,
  .comment-modal-actions a:focus-visible,
  .comment-modal-actions button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .external-card-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .external-card-kicker span + span::before {
    content: '/';
    margin-right: 0.55rem;
    color: var(--border);
  }

  .external-card h3 {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .external-card h3 a {
    color: inherit;
  }

  .external-card h3 a:hover {
    color: var(--accent);
  }

  .comment-summary {
    display: -webkit-box;
    margin: 0;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.06rem;
    font-style: italic;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .comment-original-link {
    display: inline-block;
    margin: 1rem 1.25rem 1.25rem;
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .comment-original-link:hover {
    color: var(--accent);
  }

  .external-note {
    margin: 1rem 0 0;
    color: var(--text-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .external-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .comment-modal {
    /* Re-center: the global `* { margin: 0 }` reset overrides the UA's
       `margin: auto` that centers a :modal dialog, pinning it top-left. */
    margin: auto;
    width: min(760px, calc(100vw - 2rem));
    max-height: min(780px, calc(100vh - 2rem));
    border: 1px solid var(--border);
    padding: 0;
    background: var(--bg);
    color: var(--text);
  }

  .comment-modal::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(2px);
  }

  .comment-modal-panel {
    display: grid;
    max-height: inherit;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .comment-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding: 1.4rem 1.5rem 1.1rem;
  }

  .comment-modal-head h3 {
    margin: 0;
    font-size: 1.45rem;
  }

  .comment-modal-close {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
  }

  .comment-modal-close:hover {
    color: var(--accent);
  }

  .comment-modal-body {
    overflow: auto;
    padding: 1.5rem;
  }

  .comment-modal-body p {
    max-width: 68ch;
    margin: 0 0 1rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .comment-modal-body p:last-child {
    margin-bottom: 0;
  }

  .comment-modal-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding: 1rem 1.5rem;
  }

  .comment-modal-actions a,
  .comment-modal-actions button {
    border: 1px solid var(--border);
    padding: 0.7rem 0.9rem;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .comment-modal-actions a:hover,
  .comment-modal-actions button:hover {
    border-color: var(--accent-strong);
    color: var(--accent);
  }

  .video-card {
    padding: 0;
    overflow: hidden;
  }

  .video-thumb,
  .video-card iframe {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    border: 0;
    background: var(--surface-high);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .video-thumb:hover img {
    filter: grayscale(0) contrast(1.08);
    transform: scale(1.03);
  }

  .video-copy {
    padding: 1.25rem;
  }

  .selected-connections {
    max-width: none;
    margin-top: 5rem;
    padding-top: 3.5rem;
  }

  .selected-connections h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .connection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .selected-connections .connection {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .connection-frame {
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    background: var(--surface-high);
  }

  .connection-frame :global(.frame-img) {
    opacity: 0.72;
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }

  .connection:hover .connection-frame :global(.frame-img) {
    opacity: 1;
    transform: scale(1.04);
  }

  .selected-connections .to {
    color: var(--text);
    font-size: 1.35rem;
    transition: color 0.2s ease;
  }

  .selected-connections .connection:hover .to {
    color: var(--accent);
  }

  .selected-connections .why {
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .film-page {
      padding-block-start: 2rem;
    }

    .film-backbar {
      margin-bottom: 2rem;
    }

    .selected-film-hero {
      display: block;
      padding-bottom: 3rem;
    }

    .selected-film-hero .film-meta {
      gap: 0.55rem;
    }

    .selected-film-hero .film-logline {
      padding-left: 1rem;
    }

    .comment-modal {
      width: calc(100vw - 1rem);
      max-height: calc(100vh - 1rem);
    }

    .comment-modal-head,
    .comment-modal-body,
    .comment-modal-actions {
