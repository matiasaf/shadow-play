---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const movies = await getCollection('movies', ({ data }) => !data.draft);
  return movies.map((movie) => ({
    params: { slug: movie.id },
    props: { movie, all: movies },
  }));
}

const { movie, all } = Astro.props;
const { data } = movie;
const { Content } = await render(movie);

// Resolver títulos de las películas conectadas
const titleBySlug = new Map(all.map((m) => [m.id, m.data.title]));
const movieBySlug = new Map(all.map((m) => [m.id, m]));

const watched = data.watchedOn.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const metaParts = [
  data.director,
  String(data.year),
  data.country,
  data.runtime ? `${data.runtime} min` : null,
].filter(Boolean);
---

<BaseLayout title={`${data.title} — Cuaderno de cine`} description={data.logline}>
  <article class="film-page">
    <div class="wrap film-backbar">
      <a href="/" class="back-link"><span aria-hidden="true">←</span> Volver al archivo</a>
    </div>

    <header class="wrap film-hero selected-film-hero">
      <div class="film-heading">
        <h1>{data.title}</h1>
        {data.originalTitle && <p class="original">{data.originalTitle}</p>}

        <div class="film-meta">
          {
            metaParts.map((part, i) => (
              <>
                {i > 0 && <span class="sep"></span>}
                <span>{part}</span>
              </>
            ))
          }
          <span class="sep"></span>
          <span class="watched">Vista el {watched}</span>
        </div>

        {
          data.rating && (
            <div class="film-rating" title={`${data.rating} de 5`}>
              {'★'.repeat(data.rating)}
              <span>{'★'.repeat(5 - data.rating)}</span>
            </div>
          )
        }

        <blockquote class="film-logline">"{data.logline}"</blockquote>
      </div>
    </header>

    <figure class="wrap frame-figure selected-frame">
      {
        data.frame ? (
          <Image src={data.frame} alt={`Fotograma de ${data.title}`} width={1100} height={620} />
        ) : (
          <div class="frame-placeholder" aria-label={`Fotograma pendiente de ${data.title}`}>
            <span>{data.title.charAt(0)}</span>
          </div>
        )
      }
      <figcaption>
        {data.frameCaption || `Fig. 1: Fotograma de estudio pendiente para ${data.title}.`}
      </figcaption>
    </figure>

    <div class="wrap">
      <div class="prose film-prose">
        <Content />
      </div>

      {
        data.connections.length > 0 && (
          <section class="connections selected-connections">
            <h2>Conexiones</h2>
            <div class="connection-grid">
              {data.connections.map((c) => {
                const title = titleBySlug.get(c.slug);
                const related = movieBySlug.get(c.slug);
                return title ? (
                  <a class="connection" href={`/peliculas/${c.slug}/`}>
                    <div class="connection-frame">
                      {related?.data.frame ? (
                        <Image
                          src={related.data.frame}
                          alt={`Fotograma de ${related.data.title}`}
                          width={420}
                          height={236}
                        />
                      ) : (
                        <span>{title.charAt(0)}</span>
                      )}
                    </div>
                    <div class="to">{title}</div>
                    <div class="why">{c.note}</div>
                  </a>
                ) : (
                  <div class="connection">
                    <div class="connection-frame"><span>{c.slug.charAt(0)}</span></div>
                    <div class="to">{c.slug}</div>
                    <div class="why">{c.note}</div>
                  </div>
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .film-page {
    padding-block: 3rem 4rem;
  }

  .film-backbar {
    margin-bottom: 3rem;
  }

  .film-backbar .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .film-backbar .back-link:hover {
    color: var(--accent);
  }

  .selected-film-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(220px, 4fr);
    gap: 2rem;
    padding-block: 0 4rem;
  }

  .film-heading {
    grid-column: 1 / 2;
  }

  .selected-film-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(3rem, 8vw, 5.6rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .selected-film-hero .original {
    margin-bottom: 1.2rem;
    color: var(--text-faint);
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }

  .selected-film-hero .film-meta {
    margin-top: 0;
    margin-bottom: 1.35rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .selected-film-hero .film-meta .sep {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--border);
  }

  .selected-film-hero .watched {
    color: var(--accent-strong);
  }

  .film-rating {
    margin-bottom: 2rem;
    color: var(--accent);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .film-rating span {
    color: var(--border);
  }

  .selected-film-hero .film-logline {
    max-width: 40rem;
    margin: 0;
    border-left: 2px solid var(--accent-strong);
    padding-left: 1.6rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-style: italic;
    line-height: 1.45;
  }

  .selected-frame {
    margin-block: 0 4rem;
  }

  .selected-frame img,
  .frame-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 4px;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.7s ease, transform 0.7s ease;
  }

  .selected-frame img:hover {
    filter: grayscale(0);
  }

  .frame-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 45%, rgba(150, 178, 207, 0.14), transparent 52%),
      var(--surface-high);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: clamp(5rem, 13vw, 10rem);
  }

  .selected-frame figcaption {
    max-width: 70ch;
    margin-top: 1.4rem;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-style: italic;
    text-align: left;
  }

  .film-prose {
    max-width: 65ch;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .film-prose h2 {
    margin-bottom: 1.4rem;
    font-size: 2rem;
  }

  .film-prose p,
  .film-prose li {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .film-prose blockquote {
    margin-block: 3rem;
    border-block: 1px solid var(--border);
    border-left: 0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .selected-connections {
    max-width: none;
    margin-top: 5rem;
    padding-top: 3.5rem;
  }

  .selected-connections h2 {
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .connection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .selected-connections .connection {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .connection-frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    overflow: hidden;
    background: var(--surface-high);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 3rem;
  }

  .connection-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.62;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .connection:hover .connection-frame img {
    opacity: 1;
    transform: scale(1.04);
  }

  .selected-connections .to {
    color: var(--text);
    font-size: 1.35rem;
    transition: color 0.2s ease;
  }

  .selected-connections .connection:hover .to {
    color: var(--accent);
  }

  .selected-connections .why {
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .film-page {
      padding-block-start: 2rem;
    }

    .film-backbar {
      margin-bottom: 2rem;
    }

    .selected-film-hero {
      display: block;
      padding-bottom: 3rem;
    }

    .selected-film-hero .film-meta {
      gap: 0.55rem;
    }

    .selected-film-hero .film-logline {
      padding-left: 1rem;
    }
  }
</style>
